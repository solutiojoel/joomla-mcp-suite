# Shared runtime ports inside the container
JOOMLA_MCP_PORT=9300
GANTRY_MCP_PORT=9301
ORCHESTRATOR_PORT=9302
FRESHDESK_MCP_PORT=9303
FTP_MCP_PORT=9304
DASHBOARD_PORT=18305

# Joomla MCP credentials
JOOMLA_BASE_URL=https://example.com/administrator
JOOMLA_USERNAME=
JOOMLA_PASSWORD=

# Optional behavior
MODULE_TYPE_BLACKLIST=
MENU_ITEM_TYPE_BLACKLIST=
DISABLED_TOOLS=

# FTP credentials used by ftp-mcp (per-site config lives in apps/ftp-mcp/ftp-sites.json;
# FTP_SITES_PATH overrides its location). credential_set entries in ftp-sites.json
# resolve FTP_<SET>_READONLY_* / FTP_<SET>_WRITE_* variants.
FTP_READONLY_USER=
FTP_READONLY_PASS=
FTP_WRITE_USER=
FTP_WRITE_PASS=

# Freshdesk API credentials used by freshdesk-mcp
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# Orchestrator inbound auth: single shared token, or per-user tokens in config/users.json
ORCHESTRATOR_TOKEN=

# Optional downstream auth tokens for orchestrator
JOOMLA_MCP_TOKEN=
GANTRY_MCP_TOKEN=
FRESHDESK_MCP_TOKEN=
FTP_MCP_TOKEN=

# Optional downstream URL overrides for orchestrator (defaults match start-all ports)
# JOOMLA_MCP_URL=http://127.0.0.1:9300/mcp
# GANTRY_MCP_URL=http://127.0.0.1:9301/mcp
# FRESHDESK_MCP_URL=http://127.0.0.1:9303/mcp
# FTP_MCP_URL=http://127.0.0.1:9304/mcp
