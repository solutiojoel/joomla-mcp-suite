# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` in this directory. This is the SINGLE source of truth for local
# dev — every server loads it via @solutio/env. Precedence:
#
#   real environment (deployment secrets)  >  apps/<name>/.env  >  this file
#
# Do not copy shared values into app-level .env files; keep those for settings
# that genuinely differ per server (HTTP_PORT). In deployment no .env exists at
# all — Replit Secrets supply the same names through the real environment.
# ─────────────────────────────────────────────────────────────────────────────

# Shared runtime ports inside the container
JOOMLA_MCP_PORT=9300
GANTRY_MCP_PORT=9301
ORCHESTRATOR_PORT=9302
FRESHDESK_MCP_PORT=9303
FTP_MCP_PORT=9304
KNOWLEDGE_GATEWAY_MCP_PORT=9306
DASHBOARD_PORT=18305

# Joomla admin credentials — shared by joomla-mcp, gantry-mcp and ftp-mcp.
# Set them once here; no server needs its own copy under a different name.
JOOMLA_BASE_URL=https://example.com/administrator
JOOMLA_USERNAME=
JOOMLA_PASSWORD=

# Optional behavior
# MODULE_TYPE_BLACKLIST blocks CREATING modules of a retired type. Substring match on
# the type title, case-insensitive. Existing modules of that type stay readable and
# editable. Example: MODULE_TYPE_BLACKLIST=roksprocket
MODULE_TYPE_BLACKLIST=
MENU_ITEM_TYPE_BLACKLIST=
DISABLED_TOOLS=

# How long the orchestrator waits on one downstream tool call before giving up.
# The site-facing servers (joomla-mcp, gantry-mcp, ftp-mcp) default to 180000;
# the MCP SDK's own 60000 default is tight for a multi-round-trip write, a
# headless-browser render, or a large upload.
# A timeout is never retried: the downstream keeps running, so a replay writes twice.
JOOMLA_MCP_CALL_TIMEOUT_MS=
GANTRY_MCP_CALL_TIMEOUT_MS=
FTP_MCP_CALL_TIMEOUT_MS=

# Outbound identity. Default "identified" appends a Solutio-MCP product token to
# a browser UA so our traffic is greppable in a host's access log and can be
# allowlisted. Use "stealth" — or list host suffixes in SOLUTIO_UA_STEALTH_HOSTS
# — for sites outside our infrastructure that will not allowlist us and that
# 403 non-browser agents. SOLUTIO_USER_AGENT overrides everything.
SOLUTIO_UA_MODE=identified
SOLUTIO_UA_STEALTH_HOSTS=
SOLUTIO_USER_AGENT=

# FTP credentials used by ftp-mcp (per-site config lives in apps/ftp-mcp/ftp-sites.json;
# FTP_SITES_PATH overrides its location). credential_set entries in ftp-sites.json
# resolve FTP_<SET>_READONLY_* / FTP_<SET>_WRITE_* variants.
FTP_READONLY_USER=
FTP_READONLY_PASS=
FTP_WRITE_USER=
FTP_WRITE_PASS=

# Freshdesk API credentials used by freshdesk-mcp
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# AI Knowledge Gateway credentials used by knowledge-gateway-mcp
KNOWLEDGE_GATEWAY_BASE_URL=https://shannon-data.replit.app/api
KNOWLEDGE_GATEWAY_API_KEY=

# Orchestrator inbound auth. A user registry wins when one loads; this single
# shared token is the fallback for when none does. Registry sources, in order:
#   1. ORCHESTRATOR_USERS_JSON  the whole registry as JSON — for deployments,
#      which never receive the gitignored file. Leave unset on a dev machine.
#   2. config/users.json        the local file (scripts/hash-tokens.js builds it)
ORCHESTRATOR_TOKEN=
ORCHESTRATOR_USERS_JSON=

# Optional downstream auth tokens for orchestrator
JOOMLA_MCP_TOKEN=
GANTRY_MCP_TOKEN=
FRESHDESK_MCP_TOKEN=
FTP_MCP_TOKEN=
KNOWLEDGE_GATEWAY_MCP_TOKEN=

# Optional downstream URL overrides for orchestrator (defaults match start-all ports)
# JOOMLA_MCP_URL=http://127.0.0.1:9300/mcp
# GANTRY_MCP_URL=http://127.0.0.1:9301/mcp
# FRESHDESK_MCP_URL=http://127.0.0.1:9303/mcp
# FTP_MCP_URL=http://127.0.0.1:9304/mcp
# KNOWLEDGE_GATEWAY_MCP_URL=http://127.0.0.1:9306/mcp

# Agent-runtime (Solutio AI Dashboard backend, apps/agent-runtime)
AGENT_RUNTIME_PORT=18310
# Bind host — keep 127.0.0.1; users come in via Cloudflare Tunnel on the box
AGENT_RUNTIME_HOST=127.0.0.1
# JWT signing secret for dashboard logins (any long random string)
RUNTIME_JWT_SECRET=
# Key for encrypting per-user Claude OAuth tokens at rest in config/runtime-users.json
RUNTIME_ENC_KEY=
ORCHESTRATOR_URL=http://127.0.0.1:9302/mcp
AGENTS_MCP_URL=http://127.0.0.1:3506/mcp
# Chat session tuning (Phase 2 — defaults shown; all optional)
# AGENT_RUNTIME_CHAT_MODEL=            # SDK default model when unset
# AGENT_RUNTIME_MAX_TURNS=60           # assistant turns per SDK loop (loop auto-resumes after)
# AGENT_RUNTIME_MAX_SESSIONS_PER_USER=2
# AGENT_RUNTIME_MAX_GLOBAL_LOOPS=5     # concurrent SDK subprocesses (box capacity)
# AGENT_RUNTIME_IDLE_MINUTES=15        # active -> idle
# AGENT_RUNTIME_CLOSE_MINUTES=60       # idle -> closed (resumes on next message)
# Jobs / proxies (Phase 3 — defaults shown; all optional)
# AGENT_RUNTIME_MAX_GLOBAL_JOBS=2      # concurrent agents-mcp job calls; extras queue FIFO
# AGENTS_DASHBOARD_URL=http://127.0.0.1:3507   # agents-mcp run monitor (runs proxy + job stop)
# The /api/knowledge proxy and job-artifact records reuse KNOWLEDGE_GATEWAY_BASE_URL/_API_KEY above
