# Env files at any depth. The bare `.env` rule missed variants like
# `.env.local` and `.env.bak-*`, which hold the same live credentials — so
# ignore every `.env.*` and re-admit only the checked-in examples.
.env
.env.*
!.env.example
!*.env.example
node_modules/
**/node_modules/
**/dist/
*.log
apps/agents-mcp/logs/
apps/gantry-mcp/discovery/
apps/gantry-mcp/exports/
apps/gantry-mcp/backups/
config/users.json
config/users.json.bak
config/runtime-users.json
apps/agent-runtime/data/
