modules = ["web", "nodejs-20", "python-3.12"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-single.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 8008

[[ports]]
localPort = 5055
externalPort = 5173

[[ports]]
localPort = 9300
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 9301
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 9303
externalPort = 80

[[ports]]
localPort = 9304
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 9305
externalPort = 4200
exposeLocalhost = true

[[ports]]
localPort = 9306
externalPort = 3001
exposeLocalhost = true

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "scripts/start-single.sh"]
build = ["bash", "-c", "npm run build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
