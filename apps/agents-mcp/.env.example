# Port for the HTTP MCP server (used by the orchestrator).
# Must match the registry port for agents-mcp in packages/mcp-downstream-client
# (3506) and the orchestrator's AGENTS_MCP_URL. Without HTTP_PORT set the
# server falls back to stdio and the orchestrator cannot reach it.
HTTP_PORT=3506

# Auth for sub-agent runs — agents-mcp drives the Claude Code engine via the
# Claude Agent SDK, so it authenticates with Claude Code credentials, not an
# Anthropic API key.
#
# On a machine where `claude` is logged in (Pro/Max subscription) nothing is
# needed here. For a headless host, mint a long-lived subscription token with
# `claude setup-token` and set it:
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
#
# An ANTHROPIC_API_KEY also works (API billing instead of subscription), but
# is not required.
