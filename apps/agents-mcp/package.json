{
  "name": "agents-mcp",
  "version": "0.1.0",
  "description": "LLM-backed sub-agent tools for the Joomla MCP suite",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "interpret": "tsx src/run-interpreter.ts",
    "interpret-content": "tsx src/run-content-interpreter.ts",
    "build-menu": "tsx src/run-builder.ts",
    "validate": "tsx src/validate-spec.ts",
    "validate-schematic": "tsx src/validate-schematic.ts",
    "derive-schematic": "tsx src/derive-schematic.ts",
    "fetch-content": "tsx src/run-content-fetch.ts",
    "build-content": "tsx src/run-content-build.ts",
    "dashboard": "tsx src/dashboard.ts",
    "test": "tsx src/bridge.test.ts && tsx src/schematic.test.ts && tsx src/content-build.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@anthropic-ai/sdk": "^0.110.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@solutio/logging": "^0.1.0",
    "@solutio/mcp-downstream-client": "^0.1.0",
    "@solutio/mcp-transport": "^0.1.0",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.6.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
