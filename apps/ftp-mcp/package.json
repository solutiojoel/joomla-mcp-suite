{
  "name": "ftp-mcp",
  "version": "1.0.0",
  "description": "MCP server for per-site FTP file tools (owns ftp-sites.json)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "start:http": "cross-env HTTP_PORT=9304 tsx src/index.ts",
    "test": "npm run build && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solutio/logging": "^0.1.0",
    "@solutio/mcp-transport": "^0.1.0",
    "basic-ftp": "^6.0.1",
    "dotenv": "^17.4.2",
    "@solutio/env": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
