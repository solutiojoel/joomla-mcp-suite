    "55": {
      "id": "55",
      "title": "Mass Times",
      "alias": "mass-times",
      "categoryId": "24",
      "categoryTitle": "Homepage Articles",
      "introtext": "\t<div class=\"mt-wrapper\">\n<div class=\"mt-content\">\n<h2 class=\"mt-big-title\">Mass Schedule</h2>\n<h3>Weekend</h3>\n<p>Saturday: 5:00 PM (Vigil)<br />Sunday: 8:00 AM, 10:00 AM, 12:00 PM, 6:00 PM</p>\n<h3>Daily Mass</h3>\n<p>Monday - Saturday: 9:00 AM</p>\n<h3>Holy Days</h3>\n<p>9:00 AM, 12:00 PM, 7:00 PM</p>\n<h3>Sacrament of Reconciliation</h3>\n<p>Saturdays: 3:00 - 4:30 PM<br />First Saturday of the Month:<br />Immediately following the 9:00 AM Mass</p>\n</div>\n<div class=\"mt-button\"><a class=\"button\" href=\"mailto:youtube.com/@ourladyofmountcarmel6322/streams?themeRefresh=1\" target=\"_blank\" rel=\"noopener noreferrer\">Watch Mass Live</a></div>\n</div>",
      "fulltext": "",
      "state": "1",
      "access": "1"
    },
    "56": {
      "id": "56",
      "title": "Welcome",
      "alias": "welcome",
      "categoryId": "24",
      "categoryTitle": "Homepage Articles",
      "introtext": "\t<div class=\"welcome-wrapper\">\n<div class=\"welcome-title\">\n<h3 class=\"g-title\">Welcome</h3>\n</div>\n<div class=\"welcome-content\">\n<p>Welcome to Our Lady of Mount Carmel Church. As a Carmelite parish, we are blessed to be a faith community centered on the Eucharist, devoted to prayer, and inspired by the Carmelite spirit of drawing closer to God in everyday life. United in worship and committed to sharing God's love with our community, we welcome all with open hearts and joyful hospitality. Whether you are joining us for Mass, exploring the Catholic faith, or looking for a parish to call home, we are glad you are here.</p>\n</div>\n</div>",
      "fulltext": "",
      "state": "1",
      "access": "1"
    },
