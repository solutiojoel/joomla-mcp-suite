      "categoryId": "24",
      "categoryTitle": "Homepage Articles",
      "introtext": "\t<div class=\"footer-wrapper\">\n<div class=\"footer-content-row\">\n<div class=\"footer-content-left\">\n<div class=\"footer-logo-icon\"><a href=\"home\"><img src=\"images/template/logomark.png\" alt=\"Footer Logo Icon\" /></a></div>\n<div class=\"footer-content-main\">\n<div class=\"footer-address\">\n<h6><a href=\"about/contact-us\">2700 Dover Ave,<br />Fairfield, CA 94533, USA</a></h6>\n<p>Phone: <a href=\"tel:7074227767\" target=\"_blank\" rel=\"noopener noreferrer\">(707) 422-7767</a> or<br /><a href=\"tel:7074227768\" target=\"_blank\" rel=\"noopener noreferrer\">(707) 422-7768</a><br />Email: <a href=\"mailto:office@olmcfairfield.org\" target=\"_blank\" rel=\"noopener noreferrer\">office@olmcfairfield.org</a></p>\n</div>\n<div class=\"footer-hours\">\n<h6>Office Hours</h6>\n<p>Monday - Friday:<br />9AM - 12PM, 1PM - 4PM<br />(or by appointment)</p>\n</div>\n</div>\n</div>\n<div class=\"footer-help-links\">\n<h6>Helpful Links</h6>\n<div class=\"footer-links-inner\"><a href=\"news/bulletin\">Bulletin</a><a href=\"about/registration\">Parish Registration</a><a href=\"news/calendar\">Calendar</a><a href=\"https://bible.usccb.org/daily-bible-reading\" target=\"_blank\" rel=\"noopener noreferrer\">Daily Readings</a></div>\n</div>\n</div>\n<div class=\"footer-bottom-row\">\n<div class=\"footer-social-icons\">{loadmoduleid 160}</div>\n<div class=\"footer-copyright\">\n<p>2026 OLMC Catholic Church. All rights reserved.</p>\n</div>\n</div>\n</div>",
