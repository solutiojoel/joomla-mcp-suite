    "245": {
      "id": "245",
      "title": "Welcome",
      "alias": "welcome",
      "categoryId": "24",
      "categoryTitle": "- Landing Homepage Articles",
      "introtext": "\t<div class=\"welcome-wrapper\">\n<div class=\"welcome-title\">\n<h3 class=\"g-title\">Welcome to the Catholic Cemeteries of the Diocese of San Diego</h3>\n</div>\n<div class=\"welcome-content\">\n<p>Holy Cross is sacred ground where we honor the dignity of every life in faith, hope, and love. As the only Catholic diocesan cemetery in San Diego County, we provide compassionate care, prayerful support, and respectful burial services rooted in the teachings of the Church and the promise of eternal life in Christ. Our serene grounds offer a place for quiet reflection, remembrance, and trust in the Resurrection.</p>\n</div>\n</div>",
      "fulltext": "",
      "state": "1",
      "access": "1"
    },
    "249": {
      "id": "249",
      "title": "Why Choose Us?",
      "alias": "why-choose-us",
      "categoryId": "24",
      "categoryTitle": "- Landing Homepage Articles",
      "introtext": "\t<div class=\"choose-wrapper\">\n<div class=\"choose-header\">\n<h1>Why Choose Us?</h1>\n<p>Holy Cross offers sacred Catholic burial in consecrated ground, rooted in Church tradition and the hope of the Resurrection.</p>\n</div>\n<div class=\"choose-icons\">{loadmoduleid 150}</div>\n<div class=\"choose-button\"><a class=\"button\" href=\"plan-ahead/why-choose-a-catholic-cemetery\">Learn More</a></div>\n</div>",
