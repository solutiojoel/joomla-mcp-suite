    "76": {
      "id": "76",
      "title": "Welcome",
      "alias": "facebook",
      "categoryId": "24",
      "categoryTitle": "Homepage Articles",
      "introtext": "\t<div class=\"wel-wrapper\">\n<div class=\"wel-title\">\n<h2>Welcome</h2>\n</div>\n<div class=\"wel-content\">\n<p>We're truly glad you're here! Inspired by the life of St. Elizabeth Ann Seton, we strive to live with a deep trust in God, a spirit of humility, and a generous love for others, especially through service and a commitment to Catholic education and family life. Whether you are visiting, searching for a parish home, or simply reaching out, know that you are warmly welcomed into a community that seeks to follow Christ with the same faith, perseverance, and charity that marked her life. We look forward to connecting with you and walking alongside you.</p>\n</div>\n<div class=\"wel-button\"><a class=\"button\" href=\"about-us/welcome-to-seas\">Learn More</a></div>\n</div>",
      "fulltext": "",
      "state": "1",
      "access": "1"
    },
