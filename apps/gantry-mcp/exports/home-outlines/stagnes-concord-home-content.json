    "55": {
      "id": "55",
      "title": "Mass Times",
      "alias": "mass-times",
      "categoryId": "24",
      "categoryTitle": "Homepage Articles",
      "introtext": "<h2 class=\"mt-big-title\">Mass Times</h2>\r\n<h3>Weekdays before Mass</h3>\r\n<p>Saturday Vigil: 5:00 pm<br />Sunday: 7:00 am, 9:00am, 11:00 am, and 5:00 pm<br />Daily: 8:00 am (no Mass on Wednesdays)</p>\r\n<h3>Mass (Via <a href=\"https://www.youtube.com/@St.AgnesCatholicChurch-cv8nk/streams\" target=\"_blank\" rel=\"noopener noreferrer\">Livestream</a>)</h3>\r\n<p>8:00 am Monday-Tuesday and Thursday-Saturday</p>\r\n<p style=\"text-align: center;\"><a class=\"button transparentbutton\" href=\"https://www.youtube.com/@St.AgnesCatholicChurch-cv8nk/streams\" target=\"_blank\" rel=\"noopener noreferrer\">Livestream</a></p>\r\n<h3>Confession</h3>\r\n<p>Saturday at 3:30 pm in the church</p>\r\n<h3>Eucharistic Adoration</h3>\r\n<p>Chapel daily from 6:00 am to 9:00 pm</p>",
