    "55": {
      "id": "55",
      "title": "Mass Times",
      "alias": "mass-times",
      "categoryId": "24",
      "categoryTitle": "Homepage Articles",
      "introtext": "\t<h2>Sunday Masses</h2>\n<p>Saturday Vigil: 5:00 p.m.<br />Sunday: 7:30, 9:00 and 11:00 a.m.</p>\n<h2>Weekday Masses</h2>\n<p>M - F: 6:15 and 9:00 a.m. Saturday 9:00 a.m.</p>\n<h2>Confessions</h2>\n<p>Monday: 9:30 a.m.<br />Wednesday: 7:00 - 7:45 p.m.<br />Friday: 6:45 a.m. <br />Saturday: 3:30 - 4:30 p.m.</p>\n<h2>Adoration &amp; Novena</h2>\n<p>Wednesday: 9 a.m. - 1 p.m. &amp; Holy Hour 7:15 p.m. - 8:15 p.m.<br />Monday: 7:15 p.m. <em>Novena to Our Lady of Perpetual Help</em></p>",
      "fulltext": "",
      "state": "1",
      "access": "1"
    },
