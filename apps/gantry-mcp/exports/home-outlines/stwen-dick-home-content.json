    "218227": {
      "id": "218227",
      "title": "Footer",
      "alias": "footer",
      "categoryId": "57",
      "categoryTitle": "Homepage Articles - Edit Only",
      "introtext": "<div class=\"footer-wrapper\">\r\n<div class=\"footer-content-row\">\r\n<div class=\"footer-content-logo\"><a href=\"home\"><img src=\"images/template/logo-emblem.svg\" alt=\"\" /></a></div>\r\n<div class=\"footer-content\">\r\n<h1><a href=\"home\">St. Wenceslaus<br />Catholic Church</a></h1>\r\n<p>Physical Address: <a href=\"about/contact-directions\">525 3rd Street East + Dickinson, ND 58601</a><br /><a href=\"tel:7012253972\" target=\"_blank\" rel=\"noopener noreferrer\">(701) 225-3972</a> | <a href=\"mailto:stwenc@ndsupernet.com\" target=\"_blank\" rel=\"noopener noreferrer\">stwenc@ndsupernet.com</a> | <a href=\"mailto:rshea@bismarkdiocese.com\" target=\"_blank\" rel=\"noopener noreferrer\">rshea@bismarckdiocese.com</a><br />Mailing Address: <a href=\"about/contact-directions\">505 3rd Street East + Dickinson, ND 58601</a></p>\r\n</div>\r\n<div class=\"footer-important-links\">\r\n<div class=\"footer-links\"><a href=\"about/parish-registration\">Parish Registration</a><a href=\"https://www.catholicscomehome.org/\" target=\"_blank\" rel=\"noopener noreferrer\">Catholics Come Home</a><a href=\"https://trinitycatholicschools.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Trinity Catholic Schools</a><a href=\"https://bismarckdiocese.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Diocese of Bismarck</a><a href=\"https://realpresenceradio.com/\" target=\"_blank\" rel=\"noopener noreferrer\">RPR Network</a></div>\r\n</div>\r\n</div>\r\n<div class=\"footer-lower-row\">\r\n<h6>Diocese of Bismarck Safe Environment Code of Conduct</h6>\r\n<p>The Diocese of Bismarck is firmly committed to the safety of your youth. Every parish is required to stay in compliance with the Diocesan Safe Environment regulations, including background checks for employees and volunteers, training and educational opportunities, and an annual audit.</p>\r\n<p><a href=\"?option=com_fileman&amp;view=file&amp;routed=1&amp;name=CodeOfConduct%20(1).pdf&amp;folder=documents&amp;container=fileman-files\" target=\"_blank\" rel=\"noopener noreferrer\">Click here to read the Code of Conduct</a></p>\r\n<p>For complete information, visit the <a href=\"https://bismarckdiocese.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Diocese of Bismarck.</a><br />For activities and other information, <a href=\"https://bismarckdiocese.com/training-children-adults\" target=\"_blank\" rel=\"noopener noreferrer\">CLICK HERE</a></p>\r\n</div>\r\n</div>\r\n<!----comment node----><!--a=1-->",
