      "state": "1",
      "access": "1",
      "htmlExport": true
    },
    "218228": {
      "id": "218228",
      "title": "Mass Times",
      "alias": "mass-times",
      "categoryId": "57",
      "categoryTitle": "Homepage Articles - Edit Only",
      "introtext": "<h1 class=\"mt-big-title\">Mass Times</h1>\r\n<h1>Weekend Masses</h1>\r\n<p>Saturday 4:00 pm<br />Sunday 7:30 am &amp; 9:30 am</p>\r\n<h2>Daily Masses</h2>\r\n<p>Monday - 8:15 am Communion Service<br />Tuesday (Summer) - 5:15 pm Mass<br />Tuesday (School Term) - 8:15 am Mass<br />Wednesday - Friday 8:15 am Mass</p>\r\n<h3>Confessions</h3>\r\n<p>Saturdays - 2:30 - 3:45 pm<br />Tuesday - Friday: 30 Minutes prior to Mass<br />or by appointment</p>\r\n<h4>Adoration</h4>\r\n<p>Tuesdays 8:30 am - 9:00 pm</p>\r\n<!--a=1-->",
      "fulltext": "",
      "state": "1",
      "access": "1",
      "htmlExport": true
    },
