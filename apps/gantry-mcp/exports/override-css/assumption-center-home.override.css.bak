/*MAIN*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-container-main {
        background: url('/images/template/bg-news.jpeg') 50% 50% no-repeat;
        background-size: cover;
        position: relative;
    }
    .site-home #g-container-main:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(var(--tertiary-color-rgb),.7);
        backdrop-filter: blur(13px);
        --webkit-backdrop-filter: blur(13px);
        z-index: 1;
    }
    .site-home #g-container-main > .g-container {
        position: relative;
        z-index: 2;
    }
    .site-home #g-container-main:has(.headlines-rounded-square) > .g-container {
        padding: min(4vw, 4rem) min(2vw, 2rem)!important;
    }

    .site-home #g-container-main:has(.headlines-rounded-square) > .g-container > .g-grid {
        gap: min(4vw, 4rem);
        align-items: center;
    }
}

@media only screen and (max-width: 50.99rem) {
