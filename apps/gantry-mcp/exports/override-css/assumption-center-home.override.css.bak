  #g-navigation.is-sticky > .g-container {
    position: static !important;
  }

  #g-navigation > .nav-sticky-placeholder {
    display: none !important;
  }
}*/

@media only screen and (min-width: 50.99rem) {
    .nav-menu-button {
        margin: 0;
        padding: 0;
    }
    .nav-menu-button > div {
        margin: 0;
        padding: 0;
    }
    .nav-menu-button > div > div {
        margin: 0;
        padding: 0;
    }
    .nav-menu-button .g-blockcontent {
        margin: 0;
        padding: 0;
    }
    .nav-menu-button .g-blockcontent-subcontent {
        margin: 0;
        padding: 0;
    }
    .nav-menu-button .g-blockcontent-subcontent-block {
        margin: 0;
        padding: 0;
    }
    .nav-menu-button .g-blockcontent-subcontent-block-content {
        margin: 0;
        padding: 0;
    }
    .nav-menu-button .g-blockcontent-subcontent-title-icon {
        margin: 0;
        padding: 0;
    }
    .nav-menu-button .g-blockcontent-subcontent-title {
        margin: 0;
        padding: 0;
        display: none!important;
    }
    .nav-menu-button .g-blockcontent-subcontent-title-text {
        margin: 0;
        padding: 0;
    }
    .nav-menu-button .g-blockcontent-buttons {
        margin: 0;
        padding: 0;
        display: none!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    /* Make the nav section the stacking context */
    #g-navigation {
        position: relative;
        isolation: isolate;
    }

    /* Full-screen blurred/tinted layer */
    #g-navigation::before {
        content: "";
        position: fixed;
        inset: 0;
        background: rgba(var(--primary-color-rgb), 0.9);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.3s ease, visibility 0.3s ease;
        z-index: 1;
    }

    /* Show overlay when menu is open */
    #g-navigation.menu-overlay-active::before {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    /* Keep all menu UI above the overlay */
    #mainMenuBlock,
    .nav-wrapper,
    .nav-menu-bar,
    .nav-logo,
    .nav-links-menu,
    .nav-menu-button,
    .menu-toggle,
    #menuHold {
        position: relative;
        z-index: 2;
    }

    /* Keep menu hidden until open */
    #menuHold {
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease, visibility 0.3s ease;
        display: none;
        height: 0px;
    }

    #menuHold.menu-open {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
        display: flex;
    }

    #menuHold > div {
        width: 100%;
    }

    /* Optional: lock page scroll while open */
    body.menu-overlay-active {
        overflow: hidden;
        padding-right: var(--scrollbar-width, 0px);
    }

    /* Optional icon animation */
    .menu-toggle i {
        transition: transform 0.25s ease, opacity 0.25s ease;
    }

    .menu-toggle.is-active i {
        transform: rotate(180deg);
    }
}

@media only screen and (max-width: 50.99rem) {
    .nav-main-menu .g-content-array > .g-grid > .g-block {
        display: flex;
        visibility: visible;
        width: 100%;
    }

    .nav-main-menu .g-content-array > .g-grid > .g-block > .g-content {
        width: 100%;
    }    
    .nav-main-menu .nav-menu-bar .nav-logo {
        display: none!important;
    }
    .nav-main-menu .nav-menu-bar .nav-links-menu .nav-menu-button {
        display: none!important;
    }

    .ql-toplinks-studius .g-blockcontent-subcontent {
        align-items: stretch!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-navigation > .g-container {
        padding: 2rem 0!important;
    }
}

/*HEADER*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-header > .g-container {
        padding: min(2vw, 2rem) min(2vw, 2rem) min(1vw, 1rem) min(2vw, 2rem)!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home.withmaxwidth #g-header > .g-container {
