/* ARTWORK NOTES
--------------------------------------------

--------------------------------------------
*/
html body.site-home {
    --section-above-bg: var(--secondary-color);

    --section-slideshow-bg: var(--primary-color);
    --section-header-bg: var(--primary-color);
    --section-utility-bg: var(--primary-color);

    --section-extension-bg: var(--primary-color);

    /*--slideshow-height: min(42vw, 720px);
    --slideshow-height-mobile: 42vw;*/
}

html body {
    --side-menu-bg: var(--primary-color);
    --side-menu-bg-hover: var(--secondary-color);
    --side-menu-font-size-desktop: min(1.25vw, 1.25rem);
    --side-menu-font-family: var(--body-font-family);
    --side-menu-font-weight: 400;

    --section-container-top-bg: transparent;
    --section-bottom-bg: var(--primary-color);
    --section-footer-bg: var(--footer-color);
    --section-copyright-bg: var(--footer-color);
}

html body #g-navigation {
    --main-menu-text-color: var(--default-white);
    --main-menu-text-color-hover: var(--default-white);
	--main-menu-bg: transparent;
    --main-menu-bg-color: transparent;

    --navigation-floating-social-padding: min(1vw, 1rem);

    --section-navigation-bg: transparent;
}

html body.site-sub {
    --section-utility-bg: var(--tertiary-color);
    --section-container-main-bg: var(--primary-color);
}

.g-array-item-text {
    margin: 0!important;
    padding: 0!important;
}

#g-page-surround {
    background-color: var(--primary-color)!important;
}

.moduletable .nav.menu li.current.active a, .moduletable .nav.menu li a:hover {
    color: var(--primary-color);
}

#g-container-top {
    border-top: .25rem solid var(--secondary-color);
}

#g-footer {
    border-top: 2px solid var(--default-white);
}

/* NAVIGATION */
@media only screen and (min-width: 50.99rem) {
    #g-navigation > .g-container > .g-grid:has(.g-main-nav) {
        position: relative;
    }
    #g-navigation > .g-container > .g-grid:has(.g-main-nav):before {
        content: '';
        background: rgba(var(--primary-color-rgb),.85);
        height: 100%;
        width: 3000%;
        margin-left: -500%;
        margin-right: -500%;
        position: absolute;
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container {
        color: var(--default-white);
    }
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container:hover {
        background: var(--secondary-color);
        color: var(--default-white)!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .nav-wrapper {
        display: flex;
        flex-direction: column;
        gap: min(1vw, 1rem);
    }
    .nav-wrapper .nav-menu-bar {
        display: flex;
        flex-direction: row;
        gap: min(2vw, 2rem);
        justify-content: space-between;
        align-items: center;
    }

    .nav-wrapper .nav-logo img {
        width: min(30vw, 30rem)!important;
    }

    .nav-wrapper .nav-links-menu {
        display: flex;
        flex-direction: row;
        gap: min(4vw, 4rem);
        justify-content: flex-end;
        align-items: center;
    }

    .nav-wrapper .nav-menu-button {
        border: 2px solid var(--default-white);
        padding: min(1vw, 1rem) min(1.5vw, 1.5rem);
        width: min(5vw, 5rem);
        height: auto;
        aspect-ratio: 1/1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .nav-wrapper .nav-menu-button .g-blockcontent-subcontent-title-icon {
        font-size: min(2vw, 2rem);
        color: var(--secondary-color);
    }

    .nav-wrapper .ql-toplinks-studius .g-blockcontent-subcontent-block-content {
        --ql-toplinks-item-flex-direction: column;
    }

    .site-home #g-navigation {
        height: 0px;
    }

    .crawl-space > .g-container > .g-grid:has(.g-main-nav) .g-social-items a {
        color: var(--secondary-color)!important;
    }
    .crawl-space > .g-container > .g-grid:has(.g-main-nav) .g-social-items a:hover {
        opacity: .5;
    }

    #g-navigation.crawl-space .g-main-nav .g-toplevel>li:hover:not(.g-menu-item-type-particle)>.g-menu-item-container, #g-navigation.crawl-space .g-main-nav .g-toplevel>li.active:not(.g-menu-item-type-particle)>.g-menu-item-container {
        border: none;
    }

    .ql-toplinks-studius .g-blockcontent-subcontent-title {
        --ql-toplinks-title-font-size: min(1.25vw, 1.25rem);
    }
    .ql-toplinks-studius .g-blockcontent-subcontent-block-content {
        --ql-toplinks-item-padding: min(1vw, 1rem);
    }
}

@media only screen and (min-width: 50.99rem) {
  #g-navigation {
    position: relative;
    z-index: 1000;
  }

  .nav-sticky-placeholder {
    height: 0;
    pointer-events: none;
  }

  #g-navigation.is-sticky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
  }
}

