    }
    .ph-rounded-square .g-content-array > .g-grid > .g-block {
        border-bottom: .5rem solid var(--secondary-color);
    }
    .ph-rounded-square .g-item-title {
        --ph-title-color: var(--default-black);
    }

    #g-container-main:has(.headlines-rounded-square) .news-button .button {
        background: transparent;
        border: 2px solid var(--secondary-color);
        border-radius: .5rem;
        box-shadow: none;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-container-main:has(.headlines-rounded-square) .news-title h2 {
        text-transform: none;
        font-variant-caps: normal;
        font-weight: 400;
        font-size: 8vw;
    }

    .ph-rounded-square .g-content-array > .g-grid {
        border: 2px solid var(--secondary-color);
        --ph-background-color: var(--default-white);
    }
    .ph-rounded-square .g-content-array > .g-grid > .g-block {
        border-bottom: .5rem solid var(--secondary-color);
    }
    .ph-rounded-square .g-item-title {
        --ph-title-color: var(--default-black);
    }

    #g-container-main:has(.headlines-rounded-square) .news-button {
        padding: 0 1rem!important;
    }
    #g-container-main:has(.headlines-rounded-square) .news-button .button {
        background: transparent;
        border: 2px solid var(--secondary-color);
        border-radius: .5rem;
        box-shadow: none;
    }
}

/*EXTENSION*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-extension > .g-container {
        padding: min(1vw, 1rem) min(2vw, 2rem)!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .yottie-widget-header-channel-title a {
        color: var(--secondary-color)!important;
    }
    #yottie_1 .yottie-widget-header-channel-properties-item {
        color: var(--default-white)!important;
    }
    #yottie_1 .yottie-widget-video-info-title {
        color: var(--default-white)!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .yottie-widget-header-channel-title a {
        color: var(--secondary-color)!important;
    }
    #yottie_1 .yottie-widget-header-channel-properties-item {
        color: var(--default-white)!important;
    }
    #yottie_1 .yottie-widget-video-info-title {
        color: var(--default-white)!important;
    }
}

/*FOOTER*/
@media only screen and (min-width: 50.99rem) {
    #g-footer > .g-container {
        padding: min(2vw, 2rem) min(10vw, 10rem)!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-footer > .g-container {
        padding: 2rem 1rem 5rem 1rem!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .footer-wrapper {
        display: flex;
        flex-direction: row;
        gap: min(4vw, 4rem);
        justify-content: center;
        align-items: center;
    }
    .footer-wrapper:before {
        content: '';
        border-left: 2px solid var(--default-white);
        height: min(10vw, 10rem);
        order: 2;
    }
    .footer-wrapper .footer-logo-links {
        order: 1;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: min(2vw, 2rem);
        justify-content: center;
        align-items: center;
    }
    .footer-wrapper .footer-social-icons .g-social-items {
        display: flex;
        flex-direction: row;
        gap: min(1.5vw, 1.5rem);
        justify-content: center;
        align-items: center;
    }
    .footer-wrapper .footer-social-icons .g-social-items a {
        font-size: min(2vw, 2rem);
    }
    .footer-wrapper .footer-content {
        order: 3;
        flex: 1;
    }
    .footer-wrapper .footer-content p {
        margin: 0;
        padding: 0;
        font-size: min(1.5vw, 1.5rem);
        color: var(--default-white);
    }
}

@media only screen and (max-width: 50.99rem) {
    .footer-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        justify-content: center;
        align-items: center;
    }
    .footer-wrapper:before {
        content: '';
        border-top: 2px solid var(--default-white);
        order: 2;
    }
    .footer-wrapper .footer-logo-links {
        order: 1;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: center;
        align-items: center;
    }
    .footer-wrapper .footer-social-icons .g-social-items {
        display: flex;
        flex-direction: row;
        gap: 2rem;
        justify-content: center;
        align-items: center;
    }
    .footer-wrapper .footer-social-icons .g-social-items a {
        font-size: 6vw;
    }
    .footer-wrapper .footer-content {
        order: 3;
        flex: 1;
    }
    .footer-wrapper .footer-content p {
        margin: 0;
        padding: 0;
        font-size: 4vw;
        color: var(--default-white);
    }
}

/*BOTTOM*/
@media only screen and (min-width: 50.99rem) {
    #g-bottom {
        position: relative;
        z-index: 10;
    }
    #g-bottom > .g-container {
        padding: 2rem 0!important;
    }
    #g-bottom .admod td {
        padding-top: 0!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-bottom {
        position: relative;
        z-index: 10;
    }
    body.site.withmaxwidth #g-bottom > .g-container {
        padding: 2rem 0!important;
    }
    #g-bottom .admod td {
        padding-top: .5rem!important;
    }
}

.search-page #searchForm .btn {
    background: var(--primary-color);
}

.grid-articles .g-array-item-text a:not(a.button) {
    color: var(--primary-color);
}
.grid-articles .g-array-item-text a {
    color: var(--primary-color);
}

@media only screen and (max-width: 50.99rem) {
    .admod.adside tbody {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: .5rem .5rem;
    }
}

@media only screen and (max-width: 50.99rem) {
    body#site-grid.newslayout #g-container-main > .g-container {
        padding: 2rem 1rem!important;
    }
    body#site-grid.newslayout #g-container-main #g-mainbar {
        margin: 0!important;
        padding: 0!important;
    }

    #site-grid.newslayout .grid-mobile-stacked .g-item-title {
        --grid-title-font-size: 3vw;
    }
}

@media only screen and (max-width: 50.99rem) {
    body .side-menu-particle .g-blockcontent-subcontent-title-text {
        --side-menu-font-size-desktop: 4vw;
    }
}

@media only screen and (min-width: 50.99rem) {
    body[class*="-sub"]:not(.sponsorshippage) #g-container-main:has(#g-mainbar.section-padding-5, #g-aside) {
        padding-top: 2rem!important;
        padding-bottom: 2rem!important;
    }

    body.site-sub:not(.sponsorshippage) #g-container-main > .g-container {
        background: var(--default-white);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        padding: min(2vw, 2rem)!important;
    }

    body[class*="-sub"]:not(.sponsorshippage) #g-container-main:has(#g-mainbar.section-padding-5, #g-aside) #g-mainbar.section-padding-5:has(.page-header) > .g-grid > .g-block > .g-content {
        margin: 0 0 .625rem 0!important;
        padding: 0 5% 1.5rem 0!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    body.site-sub:not(.sponsorshippage) #g-container-main > .g-container {
        background: var(--default-white);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        padding: min(2vw, 2rem)!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .grid-img-box-shadow-50 .g-array-item-image {
        box-shadow: none!important;
    }
    .grid-mobile-stacked .g-array-item-image img {
        box-shadow: none!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .bulletin-page .koowa_media {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .bulletin-page .koowa_media__item {
        flex: 1;
        min-width: calc(50% - .5rem);
        max-width: calc(50% - .5rem);
    }
}

.accordian-wrapper .g-array-item-title:after {
    color: var(--default-white);
}
.accordian-wrapper .g-content-array > .g-grid.active .g-array-item-title:after {
    color: var(--primary-color);
}
.accordian-wrapper .g-content-array > .g-grid:hover .g-array-item-title:after {
    color: var(--primary-color);
}
