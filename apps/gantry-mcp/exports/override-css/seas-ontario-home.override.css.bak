/* ARTWORK NOTES
--------------------------------------------

--------------------------------------------
*/
html body.site-home {
    --section-above-bg: var(--secondary-color);
}

html body {
    --side-menu-bg: var(--primary-color);
    --side-menu-bg-hover: var(--secondary-color);
    --side-menu-font-size-desktop: min(1.25vw, 1.25rem);
    --side-menu-font-family: var(--body-font-family);
    --side-menu-font-weight: 400;
}

html body #g-navigation {
    --main-menu-text-color: var(--default-white);
    --main-menu-text-color-hover: var(--default-white);
	--main-menu-bg: transparent;
    --main-menu-bg-color: transparent;

    --navigation-floating-social-padding: min(1vw, 1rem);
}

.g-array-item-text {
    margin: 0!important;
    padding: 0!important;
}

/* NAVIGATION */
@media only screen and (min-width: 50.99rem) {
    #g-navigation {
        background: url('/images/template/bg-header.jpg') 50% 50% no-repeat;
        background-size: cover;
        position: relative;
    }
    #g-navigation:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(var(--primary-color-rgb),.9);
        backdrop-filter: blur(30px);
        --webkit-backdrop-filter: blur(30px);
        z-index: 1;
    }
    #g-navigation > .g-container {
        position: relative;
        z-index: 2;
        background: transparent;
    }
    #g-navigation > .g-container > .g-grid:has(.nav-social-icons) {
        padding: min(1.5vw, 1.5rem) min(2vw, 2rem)!important;
    }
    .g-swiper .g-swiper-slider .swiper-slide .slide .slide-content-wrapper {
        max-height: 772px;
    }
    .fullwidth-swiper .swiper-slide img {
        max-height: 772px;
        --slideshow-width: 100%;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-navigation .nav-social-icons {
        display: none!important;
    }
    #g-navigation {
        background: url('/images/template/bg-header.jpg') 50% 50% no-repeat;
        background-size: cover;
        position: relative;
    }
    #g-navigation:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(var(--primary-color-rgb),.9);
        backdrop-filter: blur(30px);
        --webkit-backdrop-filter: blur(30px);
        z-index: 1;
    }
    #g-navigation > .g-container {
        position: relative;
        z-index: 2;
        background: transparent;
        padding: 2rem 0!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation > .g-container > .g-grid:has(.g-main-nav) {
        position: relative;
    }
    #g-navigation > .g-container > .g-grid:has(.g-main-nav):before {
        content: '';
        background: transparent;
        border-top: 2px solid var(--default-white);
        height: 100%;
        width: 3000%;
        margin-left: -500%;
        margin-right: -500%;
        position: absolute;
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation.crawl-space .g-main-nav .g-toplevel>li:hover:not(.g-menu-item-type-particle)>.g-menu-item-container, #g-navigation.crawl-space .g-main-nav .g-toplevel>li.active:not(.g-menu-item-type-particle)>.g-menu-item-container {
        border: none;
        margin: 0;
    }
    .crawl-space .g-main-nav .g-toplevel>li:not(.g-toplevel>li:has(.g-social-items))>.g-menu-item-container {
        --navigation-menu-item-padding: min(1.5vw, 1.5rem) min(1vw, 14.4px);
    }

    .crawl-space .g-toplevel > li:has(.g-social-items) {
        display: none!important;
    }
    .crawl-space > .g-container > .g-grid:has(.nav-social-icons) {
        background: transparent;
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container {
        color: var(--default-white);
    }
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container:hover {
        background: var(--secondary-color);
        color: var(--default-white)!important;
    }
}

/*SLIDESHOW*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-slideshow > .g-container {
        padding: min(2vw, 2rem)!important;
        position: relative;
    }
    .site-home #g-slideshow .fullwidth-swiper {
        border: 2px solid var(--default-white);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
    }
    .site-home #g-slideshow > .g-container > .g-grid:has(.mt-overlay-schedule) {
        position: absolute;
        top: min(4vw, 4rem);
        bottom: min(4vw, 4rem);
        left: min(4vw, 4rem);
        width: 35%;
        z-index: 10;
        background: rgba(var(--default-white-rgb),.8);
        backdrop-filter: blur(20px);
        --webkit-backdrop-filter: blur(20px);
        border-radius: 1rem;
        overflow: hidden;
        padding: min(1.5vw, 1.5rem);
    }
}

@media only screen and (min-width: 50.99rem) {
    .mt-overlay-schedule :is(h1,h2,h3,h4,h5,h6) {
        margin: 0;
        padding: 0;
        color: var(--primary-color);
        line-height: 1.2;
        font-size: min(1.75vw, 1.75rem);
        text-transform: uppercase;
        font-weight: 700;
        font-variant-caps: normal;
        border-bottom: 2px solid var(--default-black);
        margin-bottom: min(1vw, 1rem);
        font-family: var(--body-font-family);
    }
    .mt-overlay-schedule :is(h1,h2,h3,h4,h5,h6).mt-big-title {
        margin: 0;
        padding: 0;
        color: var(--primary-color);
        line-height: 1.2;
        font-size: min(3vw, 3rem);
        text-transform: none;
        font-weight: 700;
        font-variant-caps: normal;
        border-bottom: none;
        margin-bottom: min(1vw, 1rem);
        font-family: var(--title-font-family);
        display: flex;
        flex-direction: row;
        gap: min(1vw, 1rem);
        align-items: center;
    }
    .mt-overlay-schedule :is(h1,h2,h3,h4,h5,h6).mt-big-title:before {
        content: '\f017';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        line-height: 1.25;
        font-size: min(2.75vw, 2.75rem);
        color: var(--primary-color);
    }
    .mt-overlay-schedule p {
        margin: 0;
        padding: 0;
        color: var(--primary-color);
        font-size: min(1.5vw, 1.5rem);
        line-height: 1.4;
        font-weight: 400;
        font-family: var(--body-font-family);
        margin-bottom: min(2.5vw, 2.5rem);
    }
}

@media only screen and (max-width: 50.99rem) {
    .mt-overlay-schedule {
        padding: 1rem;
    }
    .mt-overlay-schedule :is(h1,h2,h3,h4,h5,h6) {
        margin: 0;
        padding: 0;
        color: var(--primary-color);
        line-height: 1.2;
        font-size: 6vw;
        text-transform: uppercase;
        font-weight: 700;
        font-variant-caps: normal;
        border-bottom: 2px solid var(--default-black);
        margin-bottom: 1rem;
        font-family: var(--body-font-family);
    }
    .mt-overlay-schedule :is(h1,h2,h3,h4,h5,h6).mt-big-title {
        margin: 0;
        padding: 0;
        color: var(--primary-color);
        line-height: 1.2;
        font-size: 8vw;
        text-transform: none;
        font-weight: 700;
        font-variant-caps: normal;
        border-bottom: none;
        margin-bottom: 1rem;
        font-family: var(--title-font-family);
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: center;
    }
    .mt-overlay-schedule :is(h1,h2,h3,h4,h5,h6).mt-big-title:before {
        content: '\f017';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        line-height: 1.25;
        font-size: 7vw;
        color: var(--primary-color);
    }
    .mt-overlay-schedule p {
        margin: 0;
        padding: 0;
        color: var(--primary-color);
        font-size: 4vw;
        line-height: 1.4;
        font-weight: 400;
        font-family: var(--body-font-family);
        margin-bottom: 1.5rem;
    }
}

/*UTILITY*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-utility > .g-container {
        padding: min(2vw, 2rem)!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home.withmaxwidth #g-utility > .g-container {
        padding: 2rem 1rem!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .ql-circle-row {
        margin: 0;
        padding: 0;
    }
    .ql-circle-row > .g-content {
        margin: 0;
        padding: 0;
    }
    .ql-circle-row > .g-content > div {
        margin: 0;
        padding: 0;
    }
    .ql-circle-row .g-blockcontent {
        margin: 0;
        padding: 0;
    }
    .ql-circle-row .g-blockcontent-subcontent {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        gap: min(2vw, 2rem);
    }
    .ql-circle-row .g-blockcontent-subcontent-block {
        margin: 0;
        padding: 0;
        flex: 1;
        position: relative;
        border-radius: 50%;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        border: 2px solid var(--default-white);
        transition: .3s all ease-in-out;
    }
    .ql-circle-row .g-blockcontent-subcontent-block:hover .g-blockcontent-subcontent-block-content:before {
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        border: 2px solid transparent;
    }
    .ql-circle-row .g-blockcontent-subcontent-block-content {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ql-circle-row .g-blockcontent-subcontent-img {
        margin: 0;
        padding: 0;
        width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        object-position: center;
        object-fit: cover;
        transition: .3s all ease-in-out;
    }
    .ql-circle-row .g-blockcontent-subcontent-title {
        margin: 0;
        padding: min(2vw, 2rem);
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(var(--primary-color-rgb),.6);
        text-align: center;
        color: var(--default-white);
        line-height: 1.1;
        font-size: min(1.25vw, 1.25rem);
        font-weight: 400;
        font-family: var(--body-font-family);
        transition: .3s all ease-in-out;
        z-index: 2;
        pointer-events: none;
    }
    .ql-circle-row .g-blockcontent-subcontent-block-content:before {
        content: '';
        position: absolute;
        top: min(1vw, 1rem);
        bottom: min(1vw, 1rem);
        left: min(1vw, 1rem);
        right: min(1vw, 1rem);
        border: 2px solid var(--tertiary-color);
        border-radius: 50%;
        z-index: 3;
        transition: .3s all ease-in-out;
        pointer-events: none;
    }
    .ql-circle-row .g-blockcontent-subcontent-desc {
        z-index: 1;
        margin: 0;
        padding: 0;
        pointer-events: all!important;
    }
    .ql-circle-row .g-blockcontent-subcontent-title-text {
        margin: 0;
        padding: 0;
        text-align: center;
        color: var(--default-white);
        line-height: 1.1;
        font-size: min(1.25vw, 1.25rem);
        font-weight: 400;
        font-family: var(--body-font-family);
        transition: .3s all ease-in-out;
    }
    .ql-circle-row .g-blockcontent-buttons {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
        z-index: 5;
        pointer-events: all!important;
    }
    .ql-circle-row .g-blockcontent-buttons a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
        z-index: 5;
        pointer-events: all!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .ql-circle-row {
        margin: 0;
        padding: 0;
    }
    .ql-circle-row > .g-content {
        margin: 0;
        padding: 0;
    }
    .ql-circle-row > .g-content > div {
        margin: 0;
        padding: 0;
    }
    .ql-circle-row .g-blockcontent {
        margin: 0;
        padding: 0;
    }
    .ql-circle-row .g-blockcontent-subcontent {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 1rem;
    }
    .ql-circle-row .g-blockcontent-subcontent-block {
        margin: 0;
        padding: 0;
        flex: 1;
        min-width: calc(50% - .5rem);
        max-width: calc(50% - .5rem);
        position: relative;
        border-radius: 50%;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        border: 2px solid var(--default-white);
        transition: .3s all ease-in-out;
    }
    .ql-circle-row .g-blockcontent-subcontent-block:hover .g-blockcontent-subcontent-block-content:before {
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        border: 2px solid transparent;
    }
    .ql-circle-row .g-blockcontent-subcontent-block-content {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ql-circle-row .g-blockcontent-subcontent-img {
        margin: 0;
        padding: 0;
        width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        object-position: center;
        object-fit: cover;
        transition: .3s all ease-in-out;
    }
    .ql-circle-row .g-blockcontent-subcontent-title {
        margin: 0;
        padding: 2rem;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(var(--primary-color-rgb),.6);
        text-align: center;
        color: var(--default-white);
        line-height: 1.1;
        font-size: 4vw;
        font-weight: 400;
        font-family: var(--body-font-family);
        transition: .3s all ease-in-out;
        z-index: 5;
        pointer-events: none;
    }
    .ql-circle-row .g-blockcontent-subcontent-block-content:before {
        content: '';
        position: absolute;
        top: 1rem;
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        border: 2px solid var(--tertiary-color);
        border-radius: 50%;
        z-index: 6;
        transition: .3s all ease-in-out;
        pointer-events: none;
    }
    .ql-circle-row .g-blockcontent-subcontent-title-text {
        margin: 0;
        padding: 0;
        text-align: center;
        color: var(--default-white);
        line-height: 1.1;
        font-size: 4vw;
        font-weight: 400;
        font-family: var(--body-font-family);
        transition: .3s all ease-in-out;
        z-index: 2;
        pointer-events: none;
    }
    .ql-circle-row .g-blockcontent-subcontent-desc {
        z-index: 1;
        margin: 0;
        padding: 0;
        pointer-events: all!important;
    }
    .ql-circle-row .g-blockcontent-buttons {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
        z-index: 5;
    }
    .ql-circle-row .g-blockcontent-buttons a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
        z-index: 5;
    }
}

/*MAIN*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-container-main:has(.news-to-me) > .g-container {
        --headlines-section-padding: min(1vw, 1rem) min(2vw, 2rem);
    }

    .ph-sidenews .g-title {
        font-size: min(3vw, 3rem)!important;
        text-transform: none!important;
        font-variant-caps: normal!important;
        line-height: 1!important;
        font-weight: 700!important;
        font-family: var(--title-font-family)!important;
        color: var(--primary-color)!important;
        margin-bottom: min(1.5vw, 1.5rem)!important;
    }

    .site-home #g-sidebar {
        display: flex;
        flex-direction: column;
        gap: min(1.5vw, 1.5rem);
    }

    .news-button .button {
        margin: 0!important;
        padding: min(.75vw, .75rem) min(2.5vw, 2.5rem)!important;
        color: var(--default-white)!important;
        text-align: center!important;
        font-size: min(1.25vw, 1.25rem)!important;
        line-height: 1!important;
        font-family: var(--body-font-family)!important;
        text-transform: none!important;
        font-variant-caps: normal!important;
        background: var(--primary-color)!important;
        font-weight: 600!important;
        border-radius: 1.25rem / 50%!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    body.site-home.site.withmaxwidth #g-container-main:has(.news-to-me) > .g-container {
        padding: 2rem 0!important;
    }

    .ph-sidenews .g-title {
        font-size: 8vw!important;
        text-transform: none!important;
        font-variant-caps: normal!important;
        line-height: 1!important;
        font-weight: 700!important;
        font-family: var(--title-font-family)!important;
        color: var(--primary-color)!important;
        margin-bottom: 1rem!important;
        text-align: center;
    }

    .site-home #g-sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .news-button .button {
        margin: 0!important;
        padding: 1rem!important;
        color: var(--default-white)!important;
        text-align: center!important;
        font-size: 4vw!important;
        line-height: 1!important;
        font-family: var(--body-font-family)!important;
        text-transform: none!important;
        font-variant-caps: normal!important;
        background: var(--primary-color)!important;
        font-weight: 600!important;
        border-radius: 1.25rem / 50%!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .ph-sidenews {
        margin: 0;
        padding: 0;
    }
    .ph-sidenews > .g-content {
        margin: 0;
        padding: 0;
    }
    .ph-sidenews .g-content-array {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    .ph-sidenews .g-content-array > .g-grid {
        margin: 0;
        padding: min(1vw, 1rem) 0;
        position: relative;
        transition: .3s all ease-in-out;
        border-bottom: 2px solid var(--secondary-color);
    }
    .ph-sidenews .g-content-array > .g-grid:hover > .g-block {
        background: rgba(var(--secondary-color-rgb),.4);
    }
    .ph-sidenews .g-content-array > .g-grid > .g-block:after {
        content: '\f138';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        color: var(--primary-color);
        line-height: 1.25;
        font-size: min(2vw, 2rem);
        position: absolute;
        top: 0;
        right: min(1vw, 1rem);
        bottom: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        pointer-events: none!important;
    }
    .ph-sidenews .g-content-array > .g-grid > .g-block {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
        border-radius: 1rem;
    }
    .ph-sidenews .g-content-array > .g-grid > .g-block > .g-content {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-image {
        margin: 0;
        padding: min(1.5vw, 1.5rem) min(1.5vw, 1.5rem) min(1.5vw, 1.5rem) min(1.5vw, 1.5rem);
        float: left;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-image a {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-image img {
        margin: 0;
        padding: 0;
        width: 100%;
        max-width: min(10vw, 10rem);
        height: auto;
        aspect-ratio: 1/1;
        object-position: center;
        object-fit: cover;
        border-radius: .5rem;
        overflow: hidden;
        border-radius: 50%;
        box-shadow: var(--default-box-shadow);
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-title {
        margin: 0;
        padding: min(1.5vw, 1.5rem) min(4vw, 4rem) min(.75vw, .75rem) 0;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-item-title {
        margin: 0;
        padding: 0;
        font-size: min(1.5vw, 1.5rem);
        font-family: var(--title-font-family);
        line-height: 1.2;
        font-weight: 700;
        border: none;
        text-transform: none;
        font-variant-caps: normal;
        color: var(--primary-color);
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-item-title a {
        margin: 0;
        padding: 0;
        font-size: min(1.5vw, 1.5rem);
        font-family: var(--title-font-family);
        line-height: 1.2;
        font-weight: 700;
        border: none;
        text-transform: none;
        font-variant-caps: normal;
        color: var(--primary-color);
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-text {
        margin: 0;
        padding: 0 min(4vw, 4rem) min(1.5vw, 1.5rem) 0!important;
        font-size: min(1.25vw, 1.25rem)!important;
        font-family: var(--body-font-family);
        line-height: 1.4;
        font-weight: 400;
        color: var(--default-black);
        opacity: .7;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-read-more {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
    .ph-sidenews .g-array-item-read-more a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
}

@media only screen and (max-width: 50.99rem) {
    .ph-sidenews {
        margin: 0;
        padding: 0;
    }
    .ph-sidenews > .g-content {
        margin: 0;
        padding: 0;
    }
    .ph-sidenews .g-content-array {
        margin: 0;
        padding: 1rem 12.5vw;
        display: flex;
        flex-direction: row;
        gap: 1rem;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }
    .ph-sidenews .g-content-array::-webkit-scrollbar {
        display: none;
    }
    .ph-sidenews .g-content-array > .g-grid {
        margin: 0;
        padding: 0;
        position: relative;
        background: var(--default-white);
        border-radius: .75rem;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        transition: .3s all ease-in-out;
        flex: 0 0 75vw;
        width: 75vw;
        max-width: 75vw;
        scroll-snap-align: center;
        scroll-snap-stop: always;
        padding: 1rem;
    }
    .ph-sidenews .g-content-array > .g-grid:hover {
        transform: scale(1.05);
    }
    .ph-sidenews .g-content-array > .g-grid > .g-block {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-content-array > .g-grid > .g-block > .g-content {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }
    .ph-sidenews .g-array-item-image {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-image a {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-image img {
        margin: 0;
        padding: 0;
        width: 100%;
        max-width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        object-position: center;
        object-fit: cover;
        border-radius: 50%;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        border: 2px solid var(--default-white);
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-title {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-item-title {
        margin: 0;
        padding: 0;
        font-size: 5vw;
        font-family: var(--title-font-family);
        line-height: 1.2;
        font-weight: 600;
        border: none;
        text-transform: uppercase;
        font-variant-caps: normal;
        color: var(--primary-color);
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-item-title a {
        margin: 0;
        padding: 0;
        font-size: 5vw;
        font-family: var(--title-font-family);
        line-height: 1.2;
        font-weight: 600;
        border: none;
        text-transform: uppercase;
        font-variant-caps: normal;
        color: var(--primary-color);
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-text {
        margin: 0;
        padding: 0!important;
        font-size: 3.5vw!important;
        font-family: var(--body-font-family);
        line-height: 1.4;
        font-weight: 400;
        color: var(--default-black);
        opacity: .7;
        transition: .3s all ease-in-out;
    }
    .ph-sidenews .g-array-item-read-more {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
    .ph-sidenews .g-array-item-read-more a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
}

