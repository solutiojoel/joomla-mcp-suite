/*FOOTER*/
@media only screen and (min-width: 50.99rem) {
    #g-footer {
        border-top: 5px solid var(--tertiary-color);
    }
    #g-footer > .g-container {
        padding: min(4vw, 4rem) min(2vw, 2rem) min(6vw, 6rem) min(2vw, 2rem)!important;
    }

    .footer-wrapper {
        display: flex;
        flex-direction: row;
        gap: min(2vw, 2rem);
        align-items: center;
        justify-content: space-between;
    }
    .footer-wrapper .footer-content-column {
        display: flex;
        flex-direction: row;
        gap: min(1vw, 1rem);
    }
    .footer-wrapper .footer-social-icons .g-social-items a {
        font-size: min(2vw, 2rem);
        color: var(--tertiary-color)!important;
    }
    .footer-wrapper .footer-social-icons .g-social-items a:hover {
        color: var(--tertiary-color)!important;
    }
    .footer-wrapper .footer-content-row {
        display: flex;
        flex-direction: row;
        gap: min(4vw, 4rem);
    }
    .footer-wrapper .footer-content-row h2 {
        margin: 0;
        padding: 0;
        line-height: 1.1;
        font-family: var(--title-font-family);
        font-size: min(1.75vw, 1.75rem);
        color: var(--default-white);
        font-weight: 600;
        text-transform: none;
        font-variant-caps: normal;
        margin-bottom: min(.5vw, .5rem);
    }
    .footer-wrapper .footer-content-row p {
        margin: 0;
        padding: 0;
        line-height: 2;
        font-size: min(1.25vw, 1.25rem);
        color: var(--default-white);
        font-family: var(--body-font-family);
    }

    .footer-wrapper .footer-logo-icons {
        display: flex;
        flex-direction: row;
        gap: min(4vw, 4rem);
        align-items: center;
    }
    .footer-wrapper .footer-logo-icons img {
        width: min(12vw, 12rem);
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-footer {
        border-top: 5px solid var(--tertiary-color);
    }
    #g-footer > .g-container {
        padding: 2rem 1rem 5rem 1rem!important;
    }

    .footer-wrapper {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        align-items: flex-start;
        justify-content: flex-start;
    }
    .footer-wrapper .footer-content-column {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .footer-wrapper .footer-social-icons {
        order: 2;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
    }
    .footer-wrapper .footer-social-icons .g-social-items a {
        font-size: 8vw;
        color: var(--tertiary-color)!important;
    }
    .footer-wrapper .footer-social-icons .g-social-items a:hover {
        color: var(--tertiary-color)!important;
    }
    .footer-wrapper .footer-content-row {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        order: 1;
    }
    .footer-wrapper .footer-content-row h2 {
        margin: 0;
        padding: 0;
        line-height: 1.1;
        font-family: var(--title-font-family);
        font-size: 6vw;
        color: var(--default-white);
        font-weight: 600;
        text-transform: none;
        font-variant-caps: normal;
        margin-bottom: .5rem;
    }
    .footer-wrapper .footer-content-row p {
        margin: 0;
        padding: 0;
        line-height: 2;
        font-size: 4vw;
        color: var(--default-white);
        font-family: var(--body-font-family);
    }

    .footer-wrapper .footer-logo-icons {
        display: flex;
        flex-direction: row;
        gap: 2rem;
        align-items: center;
    }
    .footer-wrapper .footer-logo-icons img {
        width: 100%;
    }
}

/*BOTTOM*/
@media only screen and (min-width: 50.99rem) {
    #g-bottom {
        position: relative;
        z-index: 10;
    }
    #g-bottom > .g-container {
        padding: 2rem 0!important;
    }
    #g-bottom .admod td {
        padding-top: 0!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-bottom {
        position: relative;
        z-index: 10;
