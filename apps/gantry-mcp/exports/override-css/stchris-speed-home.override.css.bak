/* ARTWORK NOTES
--------------------------------------------

--------------------------------------------
*/
html body.site-home {
    --section-above-bg: var(--secondary-color);
}

html body {
    --side-menu-bg: var(--primary-color);
    --side-menu-bg-hover: var(--secondary-color);
    --side-menu-font-size-desktop: min(1.25vw, 1.25rem);
    --side-menu-font-family: var(--body-font-family);
    --side-menu-font-weight: 400;
}

html body #g-navigation {
    --section-navigation-bg: var(--default-white);

    --main-menu-text-color: var(--default-white);
    --main-menu-text-color-hover: var(--default-white);
	--main-menu-bg: var(--primary-color);
    --main-menu-bg-color: var(--primary-color);

    --navigation-floating-social-padding: min(1vw, 1rem);

    --navigation-social-item-color: var(--default-white);
    --navigation-social-item-color-hover: var(--default-white);

    --navigation-toplevel-menu-item-text-transform: uppercase;
    --navigation-toplevel-menu-item-font-weight: 600;
}

.g-array-item-text {
    margin: 0!important;
    padding: 0!important;
}

/* NAVIGATION */
@media only screen and (min-width: 50.99rem) {
    #g-navigation {
        --half-limit: 720px; /* 1440 / 2 */
        --gutter: max(0px, calc(50vw - var(--half-limit)));

        background:
            url('/images/template/bg-header.svg')
            right var(--gutter)
            top 0
            no-repeat;

        background-size: contain;
        position: relative;
        border-top: .25rem solid var(--primary-color);
    }
    #g-navigation:before {
        content: '';
        background: rgba(var(--default-white-rgb),.94);
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        position: absolute;
        z-index: 1;
    }
    #g-navigation > .g-container {
        position: relative;
        z-index: 2;
    }

    #g-navigation > .g-container > .g-grid:has(.ql-toplinks-vertical-studius) {
        background: url('/images/template/header-statue.png') 5% 100% no-repeat;
        background-size: auto 90%;
        padding: min(2vw, 2rem)
    }

    .ql-toplinks-vertical-studius {
        --ql-toplinks-icon-color: var(--primary-color);
        --ql-toplinks-title-color: var(--default-black);
        --ql-toplinks-title-font-weight: 700;
    }

    #g-navigation.center-of-attention .g-main-nav .g-toplevel>li:hover>.g-menu-item-container, #g-navigation.center-of-attention .g-main-nav .g-toplevel>li.active>.g-menu-item-container {
        border: none!important;
    }
    .center-of-attention > .g-container > .g-grid:has(.g-main-nav) .g-social-items a:hover {
        opacity: .5;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-navigation > .g-container {
        padding: 1.5rem 0 0 0!important;
    }

    .ql-toplinks-vertical-studius {
        --ql-toplinks-icon-color-mobile: var(--primary-color);
        --ql-toplinks-title-color-mobile: var(--default-black);
        --ql-toplinks-title-font-weight-mobile: 700;
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation > .g-container > .g-grid:has(.g-main-nav) {
        position: relative;
    }
    #g-navigation > .g-container > .g-grid:has(.g-main-nav):before {
        content: '';
        background: var(--primary-color);
        height: 100%;
        width: 3000%;
        margin-left: -500%;
        margin-right: -500%;
        position: absolute;
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container {
        color: var(--default-white);
    }
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container:hover {
        background: var(--secondary-color);
        color: var(--default-white)!important;
    }
}

/*SLIDESHOW*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-slideshow > .g-container {
        position: relative;
    }
    .site-home #g-slideshow > .g-container > .g-grid:has(.mass-times-overlay) {
        position: absolute;
        top: min(2vw, 2rem);
        right: min(2vw, 2rem);
        bottom: min(2vw, 2rem);
        width: 30%;
        background: rgba(var(--tertiary-color-rgb),.95);
        z-index: 2;
        padding: min(1.5vw, 1.5rem);
        border-radius: 1rem;
    }
}

@media only screen and (min-width: 50.99rem) {
    .mass-times-overlay :is(h1,h2,h3,h4,h5,h6) {
        margin: 0;
        padding: 0;
        color: var(--default-white);
        line-height: 1;
        font-family: var(--title-font-family);
        text-transform: none;
        font-variant-caps: normal;
        font-size: min(1.75vw, 1.75rem);
        font-weight: 500;
        margin-bottom: min(.5vw, .5rem);
    }
    .mass-times-overlay p {
        margin: 0;
        padding: 0;
        color: var(--default-white);
        line-height: 1.5;
        font-family: var(--body-font-family);
        text-transform: none;
        font-variant-caps: normal;
        font-size: min(1.15vw, 1.15rem);
        font-weight: 400;
        margin-bottom: min(1.5vw, 1.5rem);
    }
    .mass-times-overlay p:has(.button) {
        margin: 0;
    }
    .mass-times-overlay .button {
        background: var(--default-white);
        padding: min(.75vw, .75rem) min(2vw, 2rem);
        color: var(--default-black);
        text-transform: uppercase;
        font-weight: 600;
        font-family: var(--body-font-family);
        border-radius: .25rem;
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home #g-slideshow > .g-container > .g-grid:has(.mass-times-overlay) {
        background: rgba(var(--tertiary-color-rgb),.95);
    }
    .mass-times-overlay {
        padding: 1.5rem;
    }
    .mass-times-overlay :is(h1,h2,h3,h4,h5,h6) {
        margin: 0;
        padding: 0;
        color: var(--default-white);
        line-height: 1;
        font-family: var(--title-font-family);
        text-transform: none;
        font-variant-caps: normal;
        font-size: 6vw;
        font-weight: 500;
        margin-bottom: .5rem;
    }
    .mass-times-overlay p {
        margin: 0;
        padding: 0;
        color: var(--default-white);
        line-height: 1.5;
        font-family: var(--body-font-family);
        text-transform: none;
        font-variant-caps: normal;
        font-size: 4vw;
        font-weight: 400;
        margin-bottom: 1rem;
    }
    .mass-times-overlay p:has(.button) {
        margin: 0;
    }
    .mass-times-overlay .button {
        background: var(--default-white);
        padding: 1rem;
        color: var(--default-black);
        text-transform: uppercase;
        font-weight: 600;
        font-family: var(--body-font-family);
        border-radius: .25rem;
    }
}

/* UTILITY */
@media only screen and (min-width: 50.99rem) {
    .site-home #g-utility > .g-container {
        padding: min(2vw, 2rem) min(2vw, 2rem)!important;
    }
    .site-home #g-utility > .g-container > .g-grid {
        display: flex;
        flex-direction: row;
        gap: min(2vw, 2rem);
        align-items: center;
    }
    .site-home #g-utility > .g-container > .g-grid > .g-block:nth-child(1) {
        flex: 1;
        width: unset;
        max-width: unset;
    }
    .site-home #g-utility > .g-container > .g-grid > .g-block:nth-child(2) {
        flex: unset;
        max-width: 165px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home.withmaxwidth #g-utility > .g-container {
        padding: 2rem 1rem!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .mission-wrapper {
        display: flex;
        flex-direction: column;
        gap: min(1.5vw, 1.5rem);
    }
    .mission-wrapper .mission-title h1 {
        margin: 0;
        padding: 0;
        line-height: 1;
        font-size: min(3vw, 3rem);
        font-family: var(--title-font-family);
        color: var(--primary-color);
        font-weight: 700;
        text-transform: none;
        font-variant-caps: normal;
    }
    .mission-wrapper .mission-content p {
        margin: 0;
        padding: 0;
        line-height: 1.5;
        font-size: min(1.25vw, 1.25rem);
        font-family: var(--body-font-family);
        color: var(--default-black);
        font-weight: 400;
        text-transform: none;
        font-variant-caps: normal;
        margin-bottom: min(1.5vw, 1.5rem);
    }
    .mission-wrapper .mission-content p.nomargin {
        margin: 0!important;
    }

    .mission-wrapper .mission-content ul {
        margin: 0 0 0 1.5rem!important;
        padding: 0;
        line-height: 1.5;
        font-size: min(1.25vw, 1.25rem);
        font-family: var(--body-font-family);
        color: var(--default-black);
        font-weight: 400;
        text-transform: none;
        font-variant-caps: normal;
    }
    .mission-wrapper .mission-content ul li {
        margin: 0;
        padding: 0;
        line-height: 1.5;
        font-size: min(1.25vw, 1.25rem);
        font-family: var(--body-font-family);
        color: var(--default-black);
        font-weight: 400;
        text-transform: none;
        font-variant-caps: normal;
    }
}

/* MAIN */
@media only screen and (min-width: 50.99rem) {
    .site-home #g-container-main {
        background: url('/images/template/bg-news-facebook.jpg') 50% 50% no-repeat;
        background-size: cover;
        position: relative;
    }
    .site-home #g-container-main:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(var(--primary-color-rgb),.8);
        z-index: 1;
    }
    .site-home #g-container-main > .g-container {
        position: relative;
        z-index: 2;
        padding: min(4vw, 4rem) min(2vw, 2rem)!important;
    }

    .site-home #g-container-main:has(.news-to-me) > .g-container > .g-grid > .g-block:has(#g-sidebar) {
        background: var(--default-white);
        box-shadow: var(--default-box-shadow);
        border-radius: 1rem;
        overflow: hidden;
        padding: min(2vw, 2rem)!important;
    }

    .site-home .news-button {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .site-home .news-button .button {
        margin: 0!important;
        padding: min(1vw, 1rem) min(4vw, 4rem)!important;
        border-radius: .75rem!important;
        font-size: min(1.5vw, 1.5rem)!important;
        font-family: var(--body-font-family)!important;
        line-height: 1!important;
        text-align: center!important;
        color: var(--default-black)!important;
        border: 2px solid var(--default-black)!important;
        background: transparent!important;
        font-weight: 700!important;
        text-transform: uppercase!important;
    }
    .site-home .news-button .button:hover {
        background: var(--secondary-color)!important;
        color: var(--default-white)!important;
    }

    .site-home .facebook-widget-container .widget-title {
        display: none!important;
    }
    .site-home .facebook-widget-container .widget-button {
        display: none!important;
    }
    .site-home .facebook-widget-container.widget-container .widget-wrapper .widget-feed {
        padding: 0!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home #g-container-main {
        background: url('/images/template/bg-news-facebook.jpg') 50% 50% no-repeat;
        background-size: cover;
        position: relative;
    }
    .site-home #g-container-main:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(var(--primary-color-rgb),.8);
        z-index: 1;
    }
    .site-home.withmaxwidth #g-container-main > .g-container {
        position: relative;
        z-index: 2;
        padding: 2rem 1rem!important;
    }

    .site-home #g-container-main:has(.news-to-me) > .g-container > .g-grid > .g-block:has(#g-sidebar) {
        background: var(--default-white);
        box-shadow: var(--default-box-shadow);
        border-radius: 1rem;
        overflow: hidden;
        padding: min(2vw, 2rem)!important;
    }

    /*.site-home .news-button {
        display: flex;
        justify-content: center;
        align-items: center;
    }*/

    .site-home .news-button .button {
        margin: 0!important;
        padding: 1rem!important;
        border-radius: .75rem!important;
        font-size: 4vw!important;
        font-family: var(--body-font-family)!important;
        line-height: 1!important;
        text-align: center!important;
        color: var(--default-black)!important;
        border: 2px solid var(--default-black)!important;
        background: transparent!important;
        font-weight: 700!important;
        text-transform: uppercase!important;
        width: 100%!important;
    }
    .site-home .news-button .button:hover {
        background: var(--secondary-color)!important;
        color: var(--default-white)!important;
    }

    .site-home .facebook-widget-container .widget-title {
        display: none!important;
    }
    .site-home .facebook-widget-container .widget-button {
        display: none!important;
    }
    .site-home .facebook-widget-container.widget-container .widget-wrapper .widget-feed {
        padding: 1rem!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .ph-sideway-stack {
        margin: 0;
        padding: 0;
    }
    .ph-sideway-stack > .g-content {
        margin: 0;
        padding: 0;
    }
    .ph-sideway-stack .g-content-array {
        margin: 0;
        padding: 0;
    }
    .ph-sideway-stack .g-content-array > .g-grid {
        margin: 0;
        padding: min(1vw, 1rem) 0;
        position: relative;
        transition: .3s all ease-in-out;
        /*border-bottom: 2px solid var(--secondary-color);*/
    }
    .ph-sideway-stack .g-content-array > .g-grid:hover > .g-block {
        background: var(--tertiary-color);
        box-shadow: var(--default-box-shadow);
    }
    .ph-sideway-stack .g-content-array > .g-grid:hover :is(.g-item-title, .g-item-title a) {
        color: var(--default-white);
    }
    .ph-sideway-stack .g-content-array > .g-grid:hover .g-array-item-text {
        color: var(--default-white);
    }
    .ph-sideway-stack .g-content-array > .g-grid > .g-block {
        margin: 0;
        padding: min(.75vw, .75rem) min(.75vw, .75rem);
        transition: .3s all ease-in-out;
        background: transparent;
        border-radius: .5rem;
    }
    .ph-sideway-stack .g-content-array > .g-grid > .g-block > .g-content {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-sideway-stack .g-array-item {
        margin: 0;
        padding: 0;
        /*float: left;*/
        transition: .3s all ease-in-out;
    }
    .ph-sideway-stack .g-array-item-image {
        margin: 0;
        padding: 0;
        width: min(11vw, 11rem);
        float: left;
        margin-right: min(1.5vw, 1.5rem);
        transition: .3s all ease-in-out;
    }
    .ph-sideway-stack .g-array-item-image a {
        margin: 0;
        padding: 0;
        pointer-events: none!important;
        transition: .3s all ease-in-out;
    }
    .ph-sideway-stack .g-array-item-image img {
        margin: 0;
        padding: 0;
        width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        object-fit: cover;
        object-position: center;
        transition: .3s all ease-in-out;
        border-radius: 50%;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        border: 1px solid var(--default-white);
    }
    .ph-sideway-stack .g-array-item-title {
        margin: 0;
        padding: 0;
        /*float: left;*/
        transition: .3s all ease-in-out;
    }
    .ph-sideway-stack .g-item-title {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
        border: none;
        color: var(--default-black);
        font-family: var(--title-font-family);
        font-size: min(1.5vw, 1.5rem);
        font-weight: 700;
        line-height: 1;
        text-transform: none;
        font-variant-caps: normal;
        margin-bottom: min(.5vw, .5rem);
    }
    .ph-sideway-stack .g-item-title a {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
        border: none;
        color: var(--default-black);
        font-family: var(--title-font-family);
        font-size: min(1.5vw, 1.5rem);
        font-weight: 700;
        line-height: 1;
        text-transform: none;
        font-variant-caps: normal;
        margin-bottom: min(.5vw, .5rem);
    }
    .ph-sideway-stack .g-array-item-text {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
        color: var(--default-black);
        font-size: min(1.25vw, 1.25rem);
        line-height: 1.3;
    }
    .ph-sideway-stack .g-array-item-read-more {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
    .ph-sideway-stack .g-array-item-read-more a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
}

@media only screen and (max-width: 50.99rem) {
    .ph-sideway-stack {
        margin: 0;
        padding: 0;
    }
    .ph-sideway-stack > .g-content {
