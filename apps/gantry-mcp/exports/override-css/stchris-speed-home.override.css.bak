        font-variant-caps: normal;
        margin-bottom: .5rem;
    }
    .ph-sideway-stack .g-item-title a {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
        border: none;
        color: var(--default-black);
        font-family: var(--title-font-family);
        font-size: 5vw;
        font-weight: 700;
        line-height: 1;
        text-transform: none;
        font-variant-caps: normal;
        margin-bottom: .5rem;
    }
    .ph-sideway-stack .g-array-item-text {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
        color: var(--default-black);
        font-size: 4vw;
        line-height: 1.3;
    }
    .ph-sideway-stack .g-array-item-read-more {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
    .ph-sideway-stack .g-array-item-read-more a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
}

/* EXTENSION */
@media only screen and (min-width: 50.99rem) {
    .site-home #g-extension > .g-container {
        padding: min(4vw, 4rem) min(2vw, 2rem)!important;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .site-home .cal-title .g-title {
        margin: 0;
        padding: 0;
        line-height: 1;
        font-size: min(3.5vw, 3.5rem);
        font-family: var(--title-font-family);
        color: var(--primary-color);
        font-weight: 700;
        text-transform: none;
        font-variant-caps: normal;
        border: none;
    }

    .site-home .cal-button {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .site-home .cal-button .button {
        margin: 0;
        padding: min(1vw, 1rem) min(4vw, 4rem);
        border-radius: .75rem;
        font-size: min(1.5vw, 1.5rem);
        font-family: var(--body-font-family);
        line-height: 1;
        text-align: center;
        color: var(--default-black);
        border: 2px solid var(--default-black);
        background: transparent;
        font-weight: 700;
        text-transform: uppercase;
    }
    .site-home .cal-button .button:hover {
        background: var(--secondary-color);
        color: var(--default-white);
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home.withmaxwidth #g-extension > .g-container {
        padding: 2rem 1rem!important;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .site-home .cal-title .g-title {
        margin: 0;
        padding: 0;
        line-height: 1;
        font-size: 8vw;
        font-family: var(--title-font-family);
        color: var(--primary-color);
        font-weight: 700;
        text-transform: none;
        font-variant-caps: normal;
        text-align: center;
        border: none;
    }

    .site-home .cal-button {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .site-home .cal-button .button {
        margin: 0;
        padding: 1rem;
        border-radius: .75rem;
        font-size: 4vw;
        font-family: var(--title-font-family);
        line-height: 1;
        text-align: center;
        color: var(--default-black);
        border: 2px solid var(--default-black);
        background: transparent;
        font-weight: 700;
        text-transform: uppercase;
        width: 100%;
    }
    .site-home .cal-button .button:hover {
        background: var(--secondary-color);
        color: var(--default-white);
    }
}

@media only screen and (min-width: 50.99rem) {
    .ec-row {
        margin: 0;
        padding: 0;
    }
    .ec-row > .g-content {
        margin: 0;
        padding: 0;
    }
    .ec-row > .g-content > div {
        margin: 0;
        padding: 0;
    }
    .ec-row .rme-items {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        gap: min(2vw, 2rem);
    }
    .ec-row .rme-item {
        margin: 0;
        padding: min(1vw, 1rem);
        flex: 1;
        background: var(--tertiary-color);
        border-radius: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: min(1.5vw, 1.5rem);
        border-radius: .75rem;
    }
    .ec-row .rme-badge {
        margin: 0;
        padding: 0;
        background: transparent;
        border-radius: 0;
        display: flex;
        flex-direction: column;
        gap: min(.5vw, .5rem);
        justify-content: center;
        align-items: flex-start;
    }
    .ec-row .rme-day {
        margin: 0;
        padding: 0;
        order: 2;
        color: var(--default-white);
        font-family: var(--title-font-family);
        line-height: 1;
        font-size: min(3vw, 3rem);
        font-weight: 700;
    }
    .ec-row .rme-month {
        margin: 0;
        padding: 0;
        order: 1;
        color: var(--default-white);
        font-family: var(--title-font-family);
        line-height: 1;
        font-size: min(2vw, 2rem);
        font-weight: 700;
    }
    .ec-row .rme-description {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: min(.5vw, .5rem);
    }
    .ec-row .rme-title {
        margin: 0;
        padding: 0;
        order: 2;
        color: var(--default-white);
        font-family: var(--body-font-family);
        line-height: 1;
        font-size: min(1.25vw, 1.25rem);
        font-weight: 400;
    }
    .ec-row .rme-time {
        margin: 0;
        padding: 0;
        order: 1;
        color: var(--default-white);
        font-family: var(--body-font-family);
        line-height: 1;
        font-size: min(1.5vw, 1.5rem);
        font-weight: 700;
    }
    .ec-row .rme-details {
        margin: 0;
        padding: 0;
        display: none!important;
    }
    .ec-row .rme-timeline {
        margin: 0;
        padding: 0;
        transform: translateY(2rem);
    }
    .ec-row .rme-arrow {
        margin: 0;
        padding: 0;
        background: #abacab;
        color: var(--default-white);
        font-size: min(2vw, 2rem);
        line-height: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: min(2vw, 2rem)!important;
        border-radius: 50%;
        font-weight: 700;
        transition: .3s all ease-in-out;
    }
    .ec-row .rme-arrow:hover {
        transform: scale(1.1);
        color: var(--primary-color);
    }
    .ec-row .rme-arrow.left {
        font-size: min(2vw, 2rem)!important;
    }
    .ec-row .rme-arrow.right {
        margin: 0;
        padding: 0;
        font-size: min(2vw, 2rem)!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .ec-row {
        margin: 0;
        padding: 0;
    }
    .ec-row > .g-content {
        margin: 0;
        padding: 0;
    }
    .ec-row > .g-content > div {
        margin: 0;
