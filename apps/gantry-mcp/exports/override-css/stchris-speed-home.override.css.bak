/*FOOTER*/
@media only screen and (min-width: 50.99rem) {
    #g-container-footer {
        border-bottom: 1rem solid var(--secondary-color);
    }

    #g-footer > .g-container {
        padding: min(4vw, 4rem) min(2vw, 2rem) min(6vw, 6rem) min(2vw, 2rem)!important;
    }

    .footer-wrapper {
        display: flex;
        flex-direction: row;
        gap: min(3vw, 3rem);
        justify-content: space-between;
        align-items: center;
    }

    .footer-wrapper .footer-icon-content {
        display: flex;
        flex-direction: row;
        gap: min(1.5vw, 1.5rem);
        justify-content: flex-start;
        align-items: center;
    }
    .footer-wrapper .footer-icon img {
        width: min(16vw, 14rem);
    }
    .footer-wrapper .footer-content h1 {
        font-size: min(3vw, 3rem);
        line-height: 1;
        margin: 0;
        padding: 0;
        font-family: var(--title-font-family);
        color: var(--default-white);
        font-weight: 700;
        text-transform: none;
        font-variant-caps: normal;
        margin-bottom: min(.5vw, .5rem);
    }
    .footer-wrapper .footer-content p {
        font-size: min(1.5vw, 1.5rem);
        line-height: 1.5;
        margin: 0;
        padding: 0;
        font-family: var(--body-font-family);
        color: var(--default-white);
        font-weight: 600;
        text-transform: none;
        font-variant-caps: normal;
    }

    .footer-wrapper .footer-links {
        display: flex;
        justify-content: flex-end;
    }
    .footer-wrapper .footer-inner-links {
        display: flex;
        flex-direction: column;
    }
    .footer-wrapper .footer-inner-links a {
        font-size: min(1.5vw, 1.5rem);
        line-height: 1.75;
        font-weight: 600;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-container-footer {
        border-bottom: 1rem solid var(--secondary-color);
    }

    body.withmaxwidth #g-footer > .g-container {
        padding-left: 0!important;
        padding-right: 0!important;
        padding: 2rem 1rem 5rem 1rem!important;
    }

    .footer-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        justify-content: space-between;
        align-items: center;
    }

    .footer-wrapper .footer-icon-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        justify-content: center;
        align-items: center;
    }
    .footer-wrapper .footer-icon {
        text-align: center;
    }
    .footer-wrapper .footer-icon img {
        width: 50%;
    }
    .footer-wrapper .footer-content h1 {
        font-size: 8vw;
        line-height: 1;
        margin: 0;
        padding: 0;
        font-family: var(--title-font-family);
        color: var(--default-white);
        font-weight: 700;
        text-transform: none;
        font-variant-caps: normal;
        margin-bottom: .5rem;
        text-align: center;
    }
    .footer-wrapper .footer-content p {
        font-size: 4vw;
        line-height: 1.5;
        margin: 0;
        padding: 0;
        font-family: var(--body-font-family);
        color: var(--default-white);
        font-weight: 600;
        text-transform: none;
        font-variant-caps: normal;
        text-align: center;
    }

    .footer-wrapper .footer-links {
        display: flex;
        justify-content: flex-end;
    }
    .footer-wrapper .footer-inner-links {
        display: flex;
        flex-direction: column;
    }
    .footer-wrapper .footer-inner-links a {
        font-size: 5vw;
        line-height: 2;
        font-weight: 600;
        text-align: center;
    }
}

/*BOTTOM*/
@media only screen and (min-width: 50.99rem) {
    #g-bottom {
        position: relative;
        z-index: 10;
    }
    #g-bottom > .g-container {
        padding: 2rem 0!important;
    }
    #g-bottom .admod td {
        padding-top: 0!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-bottom {
        position: relative;
        z-index: 10;
    }
    #g-bottom > .g-container {
        padding: 2rem 0!important;
    }
    #g-bottom .admod td {
        padding-top: 0!important;
    }
}

.search-page #searchForm .btn {
    background: var(--primary-color);
}

.grid-articles .g-array-item-text a:not(a.button) {
    color: var(--primary-color);
}
.grid-articles .g-array-item-text a {
    color: var(--primary-color);
}

@media only screen and (max-width: 50.99rem) {
    .admod.adside tbody {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: .5rem .5rem;
    }
}

@media only screen and (max-width: 50.99rem) {
    body#site-grid.newslayout #g-container-main > .g-container {
        padding: 2rem 1rem!important;
    }
    body#site-grid.newslayout #g-container-main #g-mainbar {
        margin: 0!important;
        padding: 0!important;
    }

    #site-grid.newslayout .grid-mobile-stacked .g-item-title {
        --grid-title-font-size: 6vw;
    }
}

@media only screen and (max-width: 50.99rem) {
    body .side-menu-particle .g-blockcontent-subcontent-title-text {
        --side-menu-font-size-desktop: 4vw;
    }
}

/* Ensure the container can hold the absolute-positioned X */
.pop-box {
    position: relative;
}

/* The X button style */
.close-pop-box {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 25px;
    height: 25px;
    background: #000;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: Arial, sans-serif;
    font-size: 14px;
    z-index: 10;
    border: 2px solid white;
    line-height: 0;
}

.close-pop-box:hover {
    background: #444;
}