/* ARTWORK NOTES
--------------------------------------------

--------------------------------------------
*/
html body.site-home {
    --section-above-bg: var(--secondary-color);

    --section-slideshow-bg: var(--background-color);
    --section-utility-bg: var(--background-color);

    --section-container-main-bg: var(--secondary-color);

    --section-extension-bg: var(--background-color);
}

html body {
    --side-menu-bg: var(--primary-color);
    --side-menu-bg-hover: var(--secondary-color);
    --side-menu-font-size-desktop: min(1.25vw, 1.25rem);
    --side-menu-font-family: var(--body-font-family);
    --side-menu-font-weight: 400;

    --section-bottom-bg: var(--secondary-color);
}

html body #g-navigation {
    --section-navigation-bg: var(--background-color);

    --main-menu-text-color: var(--default-white);
    --main-menu-text-color-hover: var(--default-white);
	--main-menu-bg: var(--primary-color);
    --main-menu-bg-color: var(--primary-color);

    --navigation-floating-social-padding: min(1vw, 1rem);
}

h6 {
    color: var(--primary-color);
}

.g-array-item-text {
    margin: 0!important;
    padding: 0!important;
}

.moduletable .nav.menu li.current.active a, .moduletable .nav.menu li a:hover {
    color: var(--primary-color);
}

html body #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container:hover {
    color: var(--primary-color)!important;
}

/* NAVIGATION */
@media only screen and (min-width: 50.99rem) {
    #g-navigation > .g-container > .g-grid:has(.g-main-nav) {
        position: relative;
    }
    #g-navigation > .g-container > .g-grid:has(.g-main-nav):before {
        content: '';
        background: var(--primary-color);
        height: 100%;
        width: 3000%;
        margin-left: -500%;
        margin-right: -500%;
        position: absolute;
        border-top: 3px solid var(--tertiary-color);
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container {
        color: var(--default-white);
    }
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container:hover {
        background: var(--secondary-color);
        color: var(--default-white)!important;
    }

    .crawl-space > .g-container > .g-grid:has(.g-main-nav) .g-social-items a {
        color: var(--tertiary-color)!important;
    }
    .crawl-space > .g-container > .g-grid:has(.g-main-nav) .g-social-items a:hover {
        color: var(--tertiary-color)!important;
        opacity: .5;
    }

    #g-navigation.crawl-space .g-main-nav .g-toplevel>li:hover:not(.g-menu-item-type-particle)>.g-menu-item-container, #g-navigation.crawl-space .g-main-nav .g-toplevel>li.active:not(.g-menu-item-type-particle)>.g-menu-item-container {
        border: none!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation > .g-container > .g-grid:has(.nav-contactinfo) {
        padding: min(2vw, 2rem) min(2vw, 2rem) 0 min(2vw, 2rem);
    }

    #g-navigation .g-array-item-text p {
        color: var(--primary-color);
        font-size: min(1.5vw, 1.5rem);
        line-height: 1.4;
        margin: 0;
        padding: 0;
        font-family: var(--title-font-family);
        font-weight: 600;
    }
    #g-navigation .g-array-item-text a {
        color: var(--primary-color)!important;
        transition: .3s all ease-in-out;
    }
    #g-navigation .g-array-item-text a:hover {
        color: var(--primary-color)!important;
        opacity: .5;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-navigation > .g-container {
        padding: 2rem 0 0 0!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .nav-contactinfo {
        padding: 1rem 0;
    }
    .nav-contactinfo .g-array-item-text p {
        color: var(--primary-color);
        font-size: 4vw;
        line-height: 1.4;
        margin: 0;
        padding: 0;
        font-family: var(--title-font-family);
        font-weight: 600;
        text-align: center!important;
    }
    .nav-contactinfo .g-array-item-text a {
        color: var(--primary-color)!important;
        transition: .3s all ease-in-out;
    }
    .nav-contactinfo .g-array-item-text a:hover {
        color: var(--primary-color)!important;
        opacity: .5;
    }
}

/*SLIDESHOW*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-slideshow > .g-container > .g-grid:has(.mass-times-overlay) {
        position: absolute;
        top: min(2vw, 2rem);
        bottom: min(2vw, 2rem);
        left: min(5vw, 5rem);
        z-index: 10;
        background: rgba(var(--default-white-rgb),.95);
        border-radius: .75rem;
        overflow: hidden;
        padding: min(1.5vw, 1.5rem);
        max-width: 30%;
    }

    .site-home #g-slideshow > .g-container > .g-grid:has(.mass-schedule-overlay-button) {
        position: absolute;
        bottom: min(2vw, 2rem);
        right: 0;
        z-index: 10;
    }
}

@media only screen and (min-width: 50.99rem) {
    .mass-times-overlay :is(h1,h2,h3,h4,h5,h6) {
        margin: 0;
        padding: 0;
        font-size: min(2.5vw, 2.5rem);
        line-height: 1;
        color: var(--primary-color);
        text-transform: none;
        font-variant-caps: small-caps;
        margin-bottom: min(.5vw, .5rem);
        font-weight: 600;
    }

    .mass-times-overlay p {
        margin: 0;
        padding: 0;
        line-height: 1.4;
        font-size: min(1.25vw, 1.25rem);
        margin-bottom: min(1vw, 1rem);
    }

    .mass-schedule-overlay-button .button {
        margin: 0;
        padding: min(1vw, 1rem) min(2vw, 2rem);
        display: flex;
        flex-direction: row;
        gap: min(1vw, 1rem);
        align-items: center;
        justify-content: center;
        background: rgba(var(--default-white-rgb),.9);
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
        color: var(--primary-color);
        font-family: var(--title-font-family);
        font-size: min(2vw, 2rem);
        font-weight: 600;
        line-height: 1;
        box-shadow: var(--default-box-shadow);
    }
    .mass-schedule-overlay-button .button:hover {
        transform: scale(1);
        background: var(--primary-color);
        color: var(--default-white);
    }
    .mass-schedule-overlay-button .button:before {
        content: '\e83b';
        font-family: 'fontello';
        font-weight: 900;
        color: var(--tertiary-color);
        font-size: min(2.5vw, 2.5rem);
    }
}

@media only screen and (max-width: 50.99rem) {
    .mass-times-overlay {
        padding: 1.5rem;
    }
    .mass-times-overlay :is(h1,h2,h3,h4,h5,h6) {
        margin: 0;
        padding: 0;
        font-size: 6vw;
        line-height: 1;
        color: var(--primary-color);
        text-transform: none;
        font-variant-caps: small-caps;
        margin-bottom: .5rem;
        font-weight: 600;
    }

    .mass-times-overlay p {
        margin: 0;
        padding: 0;
        line-height: 1.4;
        font-size: 4vw;
        margin-bottom: 1rem;
    }

    .mass-schedule-overlay-button {
        padding: 0 1rem 1rem 1rem;
    }
    .mass-schedule-overlay-button .button {
        margin: 0;
        padding: 1rem;
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: center;
        justify-content: center;
        background: rgba(var(--default-white-rgb),.9);
        /*border-top-right-radius: 0;
        border-bottom-right-radius: 0;*/
        color: var(--primary-color);
        font-family: var(--title-font-family);
        font-size: 4vw;
        font-weight: 600;
        line-height: 1;
        box-shadow: var(--default-box-shadow);
    }
    .mass-schedule-overlay-button .button:hover {
        transform: scale(1);
        background: var(--primary-color);
        color: var(--default-white);
    }
    .mass-schedule-overlay-button .button:before {
        content: '\e83b';
        font-family: 'fontello';
        font-weight: 900;
        color: var(--tertiary-color);
        font-size: 5vw;
    }
}

/*UTILITY*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-utility > .g-container {
        padding: min(3vw, 3rem) min(2vw, 2rem)!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home.withmaxwidth #g-utility > .g-container {
        padding: 2rem 1rem!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .ql-boxtitle {
        margin: 0;
        padding: 0;
    }
    .ql-boxtitle > .g-content {
        margin: 0;
        padding: 0;
    }
    .ql-boxtitle > .g-content > div {
        margin: 0;
        padding: 0;
    }
    .ql-boxtitle .g-blockcontent {
        margin: 0;
        padding: 0;
    }
    .ql-boxtitle .g-blockcontent-subcontent {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        gap: min(6vw, 6rem);
    }
    .ql-boxtitle .g-blockcontent-subcontent-block {
        margin: 0;
        padding: 0;
        flex: 1;
        position: relative;
        transition: .3s all ease-in-out;
    }
    .ql-boxtitle .g-blockcontent-subcontent-block:hover {
        transform: scale(1.05);
    }
    .ql-boxtitle .g-blockcontent-subcontent-block-content {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: min(1.5vw, 1.5rem);
        height: 100%;
        transition: .3s all ease-in-out;
    }
    .ql-boxtitle .g-blockcontent-subcontent-img {
        margin: 0;
        padding: 0;
        width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        object-position: center;
        object-fit: cover;
        border: 2px solid var(--default-white);
        box-shadow: var(--default-box-shadow);
        transition: .3s all ease-in-out;
    }
    .ql-boxtitle .g-blockcontent-subcontent-title {
        margin: 0;
        padding: 0;
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: min(1.75vw, 1.75rem);
        color: var(--primary-color);
        font-weight: 600;
        line-height: 1.2;
        font-family: var(--title-font-family);
        transition: .3s all ease-in-out;
    }
    .ql-boxtitle .g-blockcontent-subcontent-title-text {
        margin: 0;
        padding: 0;
        text-align: center;
        font-size: min(1.75vw, 1.75rem);
        color: var(--primary-color);
        font-weight: 600;
        line-height: 1.2;
        font-family: var(--title-font-family);
        transition: .3s all ease-in-out;
    }
    .ql-boxtitle .g-blockcontent-buttons {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
    .ql-boxtitle .g-blockcontent-buttons a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
}

@media only screen and (max-width: 50.99rem) {
    .ql-boxtitle {
        margin: 0;
        padding: 0;
    }
    .ql-boxtitle > .g-content {
        margin: 0;
        padding: 0;
    }
    .ql-boxtitle > .g-content > div {
        margin: 0;
        padding: 0;
    }
    .ql-boxtitle .g-blockcontent {
        margin: 0;
        padding: 0;
    }
    .ql-boxtitle .g-blockcontent-subcontent {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        gap: 1rem;
        justify-content: center;
    }
    .ql-boxtitle .g-blockcontent-subcontent-block {
        margin: 0;
        padding: 0;
        flex: 1;
        position: relative;
        transition: .3s all ease-in-out;
        min-width: calc(50% - .5rem);
        max-width: calc(50% - .5rem);
    }
    .ql-boxtitle .g-blockcontent-subcontent-block:hover {
        transform: scale(1.05);
    }
    .ql-boxtitle .g-blockcontent-subcontent-block-content {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
        transition: .3s all ease-in-out;
    }
    .ql-boxtitle .g-blockcontent-subcontent-img {
        margin: 0;
        padding: 0;
        width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        object-position: center;
        object-fit: cover;
        border: 2px solid var(--default-white);
        box-shadow: var(--default-box-shadow);
        transition: .3s all ease-in-out;
    }
    .ql-boxtitle .g-blockcontent-subcontent-title {
        margin: 0;
        padding: 0;
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 5vw;
        color: var(--primary-color);
        font-weight: 600;
        line-height: 1.2;
        font-family: var(--title-font-family);
        transition: .3s all ease-in-out;
    }
    .ql-boxtitle .g-blockcontent-subcontent-title-text {
        margin: 0;
        padding: 0;
        text-align: center;
        font-size: 5vw;
        color: var(--primary-color);
        font-weight: 600;
        line-height: 1.2;
        font-family: var(--title-font-family);
        transition: .3s all ease-in-out;
    }
    .ql-boxtitle .g-blockcontent-buttons {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
    .ql-boxtitle .g-blockcontent-buttons a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
}

/*MAIN*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-container-main > .g-container:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 2%;
        background: url('/images/template/angel-statue.png') 100% 110% no-repeat;
        background-size: 25%;
        z-index: 1;
        opacity: .35;
    }
    .site-home #g-container-main > .g-container > .g-grid {
        position: relative;
        z-index: 2;
    }

    .site-home #g-sidebar {
        display: flex;
        flex-direction: column;
        gap: min(2vw, 2rem);
    }

    #g-container-main:has(.news-to-me) > .g-container > .g-grid {
        --headlines-section-gap: min(8vw, 8rem);
    }
}

@media only screen and (max-width: 50.99rem) {
    html body.site-home.site.withmaxwidth #g-container-main > .g-container {
        padding: 2rem 1rem!important;
    }
    /*.site-home #g-container-main > .g-container:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 2%;
        background: url('/images/template/angel-statue.png') 100% 110% no-repeat;
        background-size: 25%;
        z-index: 1;
        opacity: .35;
    }*/
    .site-home #g-container-main > .g-container > .g-grid {
        position: relative;
        z-index: 2;
    }

    .site-home #g-sidebar {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
}

@media only screen and (min-width: 50.99rem) {
    .site-home #g-mainbar {
        height: 100%;
    }
    .site-home #g-mainbar > .g-grid {
        height: 100%;
    }
    .site-home #g-mainbar .calendar-container {
        height: 100%;
    }
    .site-home #g-mainbar .calendar-container > .g-grid {
        height: 100%;
    }
    .site-home #g-mainbar .calendar-container > .g-grid > .g-block {
        height: 100%;
    }
    .site-home #g-mainbar .calendar-container > .g-grid > .g-block > .g-content {
        height: 100%;
    }
    .site-home #g-mainbar .calendar-container .g-array-item-text {
        height: 100%;
    }
    .site-home #g-mainbar .calendar-container .g-array-item-text .calendar-widget-wrapper {
        height: 100%;
        gap: min(2vw, 2rem);
    }
}

@media only screen and (min-width: 50.99rem) {
    .ph-titlestack .g-title {
        margin: 0!important;
        padding: 0!important;
        font-size: min(3vw, 3rem)!important;
        line-height: 1!important;
        font-weight: 600!important;
        color: var(--primary-color)!important;
    }

    .site-home .calendar-widget-wrapper .widget-title .g-title {
        margin: 0!important;
        padding: 0!important;
        font-size: min(3vw, 3rem)!important;
        line-height: 1!important;
        font-weight: 600!important;
        color: var(--primary-color)!important;
    }

    .site-home #g-container-main :is(.news-button, .widget-button) .button {
        background: var(--primary-color)!important;
        width: 100%!important;
        font-weight: 700!important;
        font-family: var(--title-font-family)!important;
        padding: min(1vw, 1rem)!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .ph-titlestack .g-title {
        margin: 0!important;
        padding: 0!important;
        font-size: 6vw!important;
        line-height: 1!important;
        font-weight: 600!important;
        color: var(--primary-color)!important;
    }

    .site-home .calendar-widget-wrapper .widget-title .g-title {
        margin: 0!important;
        padding: 0!important;
        font-size: 6vw!important;
        line-height: 1!important;
        font-weight: 600!important;
        color: var(--primary-color)!important;
    }

    .site-home #g-container-main :is(.news-button, .widget-button) .button {
        background: var(--primary-color)!important;
        width: 100%!important;
        font-weight: 700!important;
        font-family: var(--title-font-family)!important;
        padding: 1rem!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .site-home .calendar-widget-wrapper .widget-feed {
        background: var(--default-white);
        border-radius: .75rem;
        overflow: hidden;
        border: 2px solid var(--default-black);
        box-shadow: var(--default-box-shadow);
        padding: min(2vw, 2rem);
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home .calendar-widget-wrapper .widget-feed {
        background: var(--default-white);
        border-radius: .75rem;
        overflow: hidden;
        border: 2px solid var(--default-black);
        box-shadow: var(--default-box-shadow);
        padding: 1rem;
    }
}

@media only screen and (min-width: 50.99rem) {
    .gcaltohtml {
        display: flex;
        flex-direction: column;
        gap: min(1.25vw, 1.25rem);
    }
    .gcaltohtml .cc-block {
        border-bottom: 2px solid var(--default-black);
        display: flex;
        flex-direction: row;
        gap: min(1.5vw, 1.5rem);
        align-items: flex-start;
        padding-bottom: min(1.25vw, 1.25rem);
    }
    .gcaltohtml .cc-dateblockformat {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
    .gcaltohtml .cc-monthformat {
        font-size: min(1.25vw, 1.25rem);
        font-weight: 700;
        font-family: var(--title-font-family);
        line-height: 1.1;
        text-transform: uppercase;
        color: var(--primary-color);
    }
    .gcaltohtml .cc-dayformat {
        font-size: min(3vw, 3rem);
        font-weight: 700;
        font-family: var(--title-font-family);
        line-height: 1.1;
        text-transform: uppercase;
        color: var(--primary-color);
    }
    .gcaltohtml .cc-eventblock {
        display: flex;
        flex-direction: column;
        gap: min(1vw, 1rem);
        width: 100%;
    }
    .gcaltohtml .cc-eventblock .event {
        display: flex;
        flex-direction: row;
        gap: min(1vw, 1rem);
    }
    .gcaltohtml .cc-eventblock .event .cc-timeofday {
        flex: 1.25;
        text-align: center;
        font-size: min(1.5vw, 1.5rem);
        line-height: 1;
        font-weight: 600;
        font-family: var(--body-font-family);
        color: var(--primary-color);
    }
    .gcaltohtml .cc-eventblock .event .cc-title {
        flex: 2.5;
        text-align: left;
        font-size: min(1.5vw, 1.5rem);
        line-height: 1;
        font-weight: 600;
        font-family: var(--body-font-family);
        color: #303234;
    }
}

@media only screen and (max-width: 50.99rem) {
    .gcaltohtml {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .gcaltohtml .cc-block {
        border-bottom: 2px solid var(--default-black);
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: flex-start;
        padding-bottom: 1rem;
    }
    .gcaltohtml .cc-dateblockformat {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
    .gcaltohtml .cc-monthformat {
        font-size: 4vw;
        font-weight: 700;
        font-family: var(--title-font-family);
        line-height: 1.1;
        text-transform: uppercase;
        color: var(--primary-color);
    }
    .gcaltohtml .cc-dayformat {
        font-size: 5vw;
        font-weight: 700;
        font-family: var(--title-font-family);
        line-height: 1.1;
        text-transform: uppercase;
        color: var(--primary-color);
    }
    .gcaltohtml .cc-eventblock {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
    }
    .gcaltohtml .cc-eventblock .event {
        display: flex;
        flex-direction: row;
        gap: 1rem;
    }
    .gcaltohtml .cc-eventblock .event .cc-timeofday {
        flex: 1.25;
