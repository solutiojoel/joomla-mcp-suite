        align-items: flex-end;
        justify-content: center;
        background: linear-gradient(to top, rgba(0,0,0,.9) 0%, rgba(0,0,0,0) 50%);
    }
    .bulletin-content .koowa_header__item--title_container {
        margin: 0!important;
        padding: 0!important;
    }
    .bulletin-content .koowa_header__item--title_container > .koowa_wrapped_content {
        margin: 0!important;
        padding: 0!important;
    }
    .bulletin-content .koowa_header__item--title_container > .koowa_wrapped_content > .whitespace_preserver {
        margin: 0!important;
        padding: 0 1rem 1rem 1rem!important;
    }
    .bulletin-content .koowa_header__item--title_container > .koowa_wrapped_content > .whitespace_preserver > .overflow_container {
        margin: 0!important;
        padding: 0!important;
        color: var(--default-white);
        font-size: 5vw;
        font-weight: 700;
        line-height: 1;
        font-family: var(--body-font-family);
    }


    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) {
        margin: 0!important;
        padding: 0!important;
        width: 100%!important;
        transition: .3s all ease-in-out;
        max-width: unset!important;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)):hover {
        transform: scale(1.05);
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_media__item__content {
        margin: 0!important;
        padding: 1rem!important;
        width: 100%!important;
        background: transparent!important;
        border: none!important;
        border-radius: 1rem!important;
        overflow: hidden!important;
        background: var(--secondary-color)!important;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_media__item__link {
        margin: 0!important;
        padding: 0!important;
        width: 100%!important;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_media__item__content-holder {
        margin: 0!important;
        padding: 0!important;
        width: 100%!important;
        position: relative!important;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_media__item__thumbnail {
        margin: 0!important;
        padding: 0!important;
        width: 100%!important;
        display: none!important;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_media__item__thumbnail img {
        margin: 0!important;
        padding: 0!important;
        width: 100%!important;
        height: auto!important;
        aspect-ratio: 3/4!important;
        object-position: center;
        object-fit: cover;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_media__item__label {
        margin: 0!important;
        padding: 0!important;
        position: relative;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        background: none!important;
        height: unset!important;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_header__item--title_container {
        margin: 0!important;
        padding: 0!important;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_header__item--title_container > .koowa_wrapped_content {
        margin: 0!important;
        padding: 0!important;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_header__item--title_container > .koowa_wrapped_content > .whitespace_preserver {
        margin: 0!important;
        padding: 0!important;
    }
    .bulletin-content .koowa_media__item:not(.koowa_media__item:nth-child(1)) .koowa_header__item--title_container > .koowa_wrapped_content > .whitespace_preserver > .overflow_container {
        margin: 0!important;
        padding: 0!important;
        color: var(--default-black);
        font-size: 5vw;
        font-weight: 700;
        line-height: 1;
        font-family: var(--body-font-family);
    }
}


/*FOOTER*/
@media only screen and (min-width: 50.99rem) {
    #g-footer > .g-container {
        padding: min(2vw, 2rem) min(2vw, 2rem) min(5vw, 5rem) min(2vw, 2rem)!important;
    }

    .footer-wrapper {
        display: flex;
        flex-direction: row;
        gap: min(3vw, 3rem);
        justify-content: space-between;
        align-items: center;
    }
    .footer-wrapper .footer-info {
        display: flex;
        flex-direction: column;
        gap: min(1vw, 1rem);
    }
    .footer-wrapper .footer-info-logo img {
        width: min(4vw, 4rem);
    }
    .footer-wrapper .footer-title {
        display: flex;
        flex-direction: row;
        gap: min(1vw, 1rem);
        align-items: center;
    }
    .footer-wrapper .footer-title h2 {
        margin: 0;
        padding: 0;
        font-size: min(2.5vw, 2.5rem);
        line-height: 1.2;
        text-transform: none;
        font-variant-caps: small-caps;
        font-weight: 700;
    }
    .footer-wrapper .footer-title h2 a {
        color: var(--tertiary-color)!important;
    }
    .footer-wrapper .footer-content p {
        margin: 0;
        padding: 0;
        line-height: 1.5;
        font-size: min(1.5vw, 1.5rem);
        color: var(--default-white);
        font-family: var(--title-font-family);
        font-weight: 600;
    }

    .footer-wrapper .footer-links-icon {
        display: flex;
        flex-direction: row;
        gap: min(4vw, 4rem);
        align-items: center;
    }
    .footer-links-icon .footer-links {
        display: flex;
        flex-direction: column;
    }
    .footer-links-icon .footer-links a {
        font-size: min(1.5vw, 1.5rem);
        line-height: 1.5;
        font-family: var(--body-font-family);
        display: flex;
        flex-direction: row;
        gap: min(.75vw, .75rem);
        align-items: center;
    }
    .footer-links-icon .footer-links a:before {
        content: '\f0da';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        color: var(--tertiary-color);
        font-size: min(2vw, 2rem);
    }
    .footer-wrapper .footer-links-icon .footer-icon img {
        width: min(15vw, 15rem);
    }
}

@media only screen and (max-width: 50.99rem) {
    .site.withmaxwidth #g-footer > .g-container {
        padding: 2rem 1rem 4rem 1rem!important;
    }

    .footer-wrapper {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        justify-content: space-between;
        align-items: flex-start;
    }
    .footer-wrapper .footer-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .footer-wrapper .footer-info-logo img {
        width: 12vw;
    }
    .footer-wrapper .footer-title {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: center;
    }
    .footer-wrapper .footer-title h2 {
        margin: 0;
        padding: 0;
        font-size: 6vw;
        line-height: 1.2;
        text-transform: none;
        font-variant-caps: small-caps;
        font-weight: 700;
    }
    .footer-wrapper .footer-title h2 a {
        color: var(--tertiary-color)!important;
    }
    .footer-wrapper .footer-content p {
        margin: 0;
        padding: 0;
        line-height: 1.5;
        font-size: 4vw;
        color: var(--default-white);
        font-family: var(--title-font-family);
        font-weight: 600;
    }

    .footer-wrapper .footer-links-icon {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .footer-links-icon .footer-links {
        display: flex;
        flex-direction: column;
    }
    .footer-links-icon .footer-links a {
        font-size: 4vw;
        line-height: 1.5;
        font-family: var(--body-font-family);
        display: flex;
        flex-direction: row;
        gap: .75rem;
        align-items: center;
    }
    .footer-links-icon .footer-links a:before {
        content: '\f0da';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        color: var(--tertiary-color);
        font-size: 5vw;
    }
    .footer-wrapper .footer-links-icon .footer-icon {
        text-align: center;
    }
    .footer-wrapper .footer-links-icon .footer-icon img {
        width: 50%;
    }
}

/*BOTTOM*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-bottom > .g-container {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }
    .site-home #g-bottom > .g-container > .g-grid:has(.sign-container) {
        padding: 0 min(2vw, 2rem)!important;
        display: flex;
        flex-direction: row;
        gap: min(8vw, 8rem);
    }
    .site-home #g-bottom > .g-container > .g-grid:has(.sign-container) > .g-block {
        flex: 1;
        width: unset;
        max-width: unset;
    }

    .site-home #g-bottom .g-title {
        margin: 0;
        padding: 0;
        text-align: left;
        font-size: min(3vw, 3rem);
        line-height: 1;
        font-weight: 600;
        font-family: var(--title-font-family);
        text-transform: none;
        font-variant-caps: small-caps;
        margin-bottom: min(1.5vw, 1.5rem);
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home #g-bottom > .g-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .site-home #g-bottom > .g-container > .g-grid:has(.sign-container) {
        padding: 0 1rem!important;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    .site-home #g-bottom > .g-container > .g-grid:has(.sign-container) > .g-block {
        flex: 1;
        width: 100%;
        max-width: 100%;
    }

    .site-home #g-bottom .g-title {
        margin: 0;
        padding: 0;
        text-align: left;
        font-size: 8vw;
        line-height: 1;
        font-weight: 600;
        font-family: var(--title-font-family);
        text-transform: none;
        font-variant-caps: small-caps;
        margin-bottom: 1rem;
    }
}

@media only screen and (min-width: 50.99rem) {
    .sl-container {
        margin: 0;
        padding: 0;
    }
    .sl-container > .g-content {
        margin: 0;
        padding: 0;
    }
    .sl-container > .g-content > div {
        margin: 0;
        padding: 0;
    }
    .sl-container .g-blockcontent {
        margin: 0;
        padding: 0;
    }
    .sl-container .g-blockcontent-subcontent {
        margin: 0;
        padding: 0;
    }
    .sl-container .g-blockcontent-subcontent-block {
        margin: 0;
        padding: 0;
        position: relative;
        border-radius: 1rem;
        overflow: hidden;
        transition: .3s all ease-in-out;
    }
    .sl-container .g-blockcontent-subcontent-block:hover {
        transform: scale(1.05);
    }
    .sl-container .g-blockcontent-subcontent-block-content {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .sl-container .g-blockcontent-subcontent-img {
        margin: 0;
        padding: 0;
        width: 100%;
        height: auto;
        aspect-ratio: 4/3;
        object-position: center;
        object-fit: cover;
        transition: .3s all ease-in-out;
    }
    .sl-container .g-blockcontent-subcontent-title {
        margin: 0;
        padding: 0;
        display: none!important;
        transition: .3s all ease-in-out;
    }
    .sl-container .g-blockcontent-subcontent-desc {
        margin: 0;
        padding: min(2vw, 2rem);
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1;
        background: rgba(var(--primary-color-rgb),.8);
        backdrop-filter: blur(6px);
        --webkit-backdrop-filter: blur(6px);
        transition: .3s all ease-in-out;
    }
    .sl-container .block-title {
        margin: 0;
        padding: 0;
        color: var(--default-white);
        line-height: 1;
        font-family: var(--title-font-family);
        font-size: min(2vw, 2rem);
        font-weight: 600;
        text-transform: none;
        font-variant-caps: normal;
    }
    .sl-container li {
        margin: 0;
        padding: 0;
        line-height: 2;
        font-size: min(1.5vw, 1.5rem);
        font-family: var(--body-font-family);
        color: var(--default-white);
    }
    .sl-container .g-blockcontent-subcontent-desc .button {
        position: absolute;
        bottom: min(1vw, 1rem);
        right: min(1vw, 1rem);
        display: flex;
        flex-direction: row;
        gap: min(1.25vw, 1.25rem);
        align-items: center;
        background: none!important;
        font-size: min(1.5vw, 1.5rem);
    }
    .sl-container .g-blockcontent-subcontent-desc .button:after {
        content: '\f138';
        font-family: 'Font Awesome 6 Free';
        color: var(--tertiary-color);
        font-size: min(3vw, 3rem);
        font-weight: 900;
    }
    .sl-container .g-blockcontent-buttons {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
        z-index: 2;
    }
    .sl-container .g-blockcontent-buttons a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
}

