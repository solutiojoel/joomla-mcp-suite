/* ARTWORK NOTES
--------------------------------------------

--------------------------------------------
*/
html body.site-home {
    --section-container-top-bg: transparent;
    --section-slideshow-bg: rgba(var(--primary-color-rgb),.85);
    --section-utility-bg: rgba(var(--primary-color-rgb),.85);
    --section-container-main-bg: rgba(var(--primary-color-rgb),.85);
    --section-above-bg: var(--secondary-color);
    --section-expanded-bg: var(--tertiary-color);
}

html body {
    --side-menu-bg: var(--primary-color);
    --side-menu-bg-hover: var(--secondary-color);
    --side-menu-font-size-desktop: min(1.25vw, 1.25rem);
    --side-menu-font-family: var(--body-font-family);
    --side-menu-font-weight: 400;

    --section-bottom-bg: var(--tertiary-color);

    --section-footer-bg: rgba(var(--primary-color-rgb),.9);
    --section-copyright-bg: rgba(var(--primary-color-rgb),.9);
}

html body #g-navigation {
    --main-menu-text-color: var(--primary-color);
    --main-menu-text-color-hover: var(--primary-color);
	--main-menu-bg: transparent;
    --main-menu-bg-color: transparent;

    --navigation-floating-social-padding: min(1vw, 1rem);

    --navigation-floating-social-items-color: var(--primary-color);
}

.g-array-item-text {
    margin: 0!important;
    padding: 0!important;
}

/* NAVIGATION */
@media only screen and (min-width: 50.99rem) {
    .site-home #g-page-surround {
        background: url('/images/template/bg-rotator-section.jpg') 50% 50% no-repeat;
        background-size: cover;
        background-attachment: fixed;
    }

    #g-navigation {
        background: url('/images/template/bg-header.jpg') 50% 50% no-repeat;
        background-size: cover;
        position: relative;
    }
    #g-navigation:before {
        content: '';
        background: rgba(var(--default-white-rgb),.9);
        backdrop-filter: blur(6px);
        --webkit-backdrop-filter: blur(6px);
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1;
    }
    #g-navigation > .g-container {
        position: relative;
        z-index: 2;
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home #g-page-surround {
        background: url('/images/template/bg-rotator-section.jpg') 50% 50% no-repeat;
        background-size: cover;
        background-attachment: fixed;
    }
    #g-navigation {
        background: url('/images/template/bg-header.jpg') 50% 50% no-repeat;
        background-size: cover;
        position: relative;
    }
    #g-navigation:before {
        content: '';
        background: rgba(var(--default-white-rgb),.9);
        backdrop-filter: blur(6px);
        --webkit-backdrop-filter: blur(6px);
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 1;
    }
    #g-navigation > .g-container {
        position: relative;
        z-index: 2;
        padding: 1.5rem 0!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation > .g-container > .g-grid:has(.g-main-nav) {
        position: relative;
    }
    #g-navigation > .g-container > .g-grid:has(.g-main-nav):before {
        content: '';
        background: linear-gradient(to bottom, #F9F9F9, #C4C4C4);
        height: 100%;
        width: 3000%;
        margin-left: -500%;
        margin-right: -500%;
        position: absolute;
        border-top: 4px solid var(--secondary-color);
    }

    .free-menu .g-main-nav .g-toplevel>li:not(.g-toplevel>li:has(.g-social-items))>.g-menu-item-container {
        padding: min(1.5vw, 1.5rem) min(1vw, 14.4px);
    }

    .free-menu .g-main-nav .g-toplevel>li>.g-menu-item-container>.g-menu-item-content>.g-menu-item-title {
        --navigation-toplevel-menu-item-font-family: var(--title-font-family);
        --navigation-toplevel-menu-item-font-size: min(1.5vw, 1.5rem);
    }

    .free-menu > .g-container > .g-grid:has(.ql-toplinks-studius) {
        padding: min(4vw, 4rem) min(2vw, 2rem) min(3vw, 3rem) min(2vw, 2rem)!important;
    }

    .free-menu > .g-container > .g-grid:has(.nav-social-icons) .g-social-items a:hover {
        opacity: .5;
    }

    .free-menu > .g-container > .g-grid:has(.nav-social-icons) {
        --navigation-floating-social-bg: transparent;
    }

    .g-main-nav .g-toplevel > li:has(.g-social-items) {
        display: none!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container {
        color: var(--default-white);
    }
    #g-navigation .g-main-nav .g-sublevel>li>.g-menu-item-container:hover {
        background: var(--secondary-color);
        color: var(--default-white)!important;
    }
}

@media only screen and (min-width: 50.99rem) {
    .ql-toplinks-studius .g-blockcontent-subcontent {
        align-items: stretch!important;
        --ql-toplinks-gap: 0;
    }
    .ql-toplinks-studius .g-blockcontent-subcontent > .g-blockcontent-subcontent-block:not(.g-blockcontent-subcontent-block:last-child) {
        border-right: 1px solid var(--primary-color);
    }
    .ql-toplinks-studius .g-blockcontent-subcontent > .g-blockcontent-subcontent-block {
        padding: 0 min(1vw, 1rem);
    }
    .ql-toplinks-studius .g-blockcontent-subcontent-block-content {
        --ql-toplinks-item-padding: min(.5vw, .5rem);
        --ql-toplinks-item-border-radius: .5rem;
        height: 100%;
    }
    .ql-toplinks-studius .g-blockcontent-subcontent-title {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        --ql-toplinks-title-font-size: min(1.25vw, 1.25rem);
        --ql-toplinks-title-color: var(--primary-color);
        font-family: var(--title-font-family);
        --ql-toplinks-title-font-weight: 700;
    }
    .ql-toplinks-studius .g-blockcontent-subcontent-title-icon {
        --ql-toplinks-icon-color: var(--primary-color);
    }
}

@media only screen and (max-width: 50.99rem) {
    .ql-toplinks-studius .g-blockcontent-subcontent {
        align-items: stretch!important;
        --ql-toplinks-gap-mobile: 0;
    }
    .ql-toplinks-studius .g-blockcontent-subcontent > .g-blockcontent-subcontent-block:not(.g-blockcontent-subcontent-block:last-child) {
        border-right: 1px solid var(--primary-color);
    }
    .ql-toplinks-studius .g-blockcontent-subcontent > .g-blockcontent-subcontent-block {
        padding: 0 1rem;
    }
    .ql-toplinks-studius .g-blockcontent-subcontent-block-content {
        --ql-toplinks-item-padding-mobile: .5rem;
        --ql-toplinks-item-border-radius-mobile: .5rem;
        height: 100%;
        overflow: visible;
    }
    .ql-toplinks-studius .g-blockcontent-subcontent-title {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        --ql-toplinks-title-font-size-mobile: 4vw;
        --ql-toplinks-title-color-mobile: var(--primary-color);
        font-family: var(--title-font-family);
        --ql-toplinks-title-font-weight-mobile: 700;
    }
    .ql-toplinks-studius .g-blockcontent-subcontent-title-icon {
        --ql-toplinks-icon-color-mobile: var(--primary-color);
    }
}

/* SLIDESHOW */
@media only screen and (min-width: 50.99rem) {
    .fullwidth-swiper {
        border: 2px solid var(--default-white);
        position: relative;
    }
    .fullwidth-swiper:before {
        content: 'Faith ~ Family ~ Fellowship';
        position: absolute;
        bottom: 0;
        left: 20%;
        right: 20%;
        background: rgba(var(--default-white-rgb),.9);
        pointer-events: none!important;
        padding: min(1vw, 1rem);
        border-top-left-radius: .5rem;
        border-top-right-radius: .5rem;
        z-index: 100;
        text-align: center;
        font-size: min(2vw, 2rem);
        line-height: 1;
        color: var(--primary-color);
        font-weight: 400;
        font-family: var(--title-font-family);
    }


    .mass-times-block .g-array-item-text :is(h1,h2,h3,h4,h5,h6) {
        --mass-times-block-title-color: var(--default-white);
        font-size: min(3vw, 3rem);
        font-family: var(--title-font-family);
        line-height: 1.2;
        border-bottom: 2px solid var(--default-white);
        font-weight: 400;
        margin-bottom: min(.75vw, .75rem);
    }
    .mass-times-block .g-array-item-text :is(p,li) {
        --mass-times-block-para-color: var(--default-white);
    }
    .mass-times-block .smaller-text {
        font-size: min(1vw, .1rem)!important;
    }

    .mt-column {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
}

@media only screen and (max-width: 50.99rem) {
    .fullwidth-swiper {
        position: relative;
    }
    .fullwidth-swiper:before {
        content: 'Faith ~ Family ~ Fellowship';
        position: absolute;
        bottom: 0;
        left: 20%;
        right: 20%;
        background: rgba(var(--default-white-rgb),.9);
        pointer-events: none!important;
        padding: 1rem;
        border-top-left-radius: .5rem;
        border-top-right-radius: .5rem;
        z-index: 100;
        text-align: center;
        font-size: 4vw;
        line-height: 1;
        color: var(--primary-color);
        font-weight: 400;
        font-family: var(--title-font-family);
    }


    .mass-times-block {
        padding: 1.5rem 1rem;
    }
    .mass-times-block .g-array-item-text :is(h1,h2,h3,h4,h5,h6) {
        --mass-times-block-title-color-mobile: var(--default-white);
        font-size: 6vw;
        font-family: var(--title-font-family);
        line-height: 1.2;
        border-bottom: 2px solid var(--default-white);
        font-weight: 400;
        margin-bottom: .75rem;
    }
    .mass-times-block .g-array-item-text :is(p,li) {
        --mass-times-block-para-color-mobile: var(--default-white);
    }
    .mass-times-block .smaller-text {
        font-size: 3.5vw!important;
    }

    .mt-column {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
    }
}

/*UTILITY*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-utility > .g-container {
        padding: min(2vw, 2rem)!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home.withmaxwidth #g-utility > .g-container {
        padding: 2rem 1rem!important;
    }
}

/*MAIN*/
@media only screen and (min-width: 50.99rem) {
    #g-container-main:has(.news-to-me) > .g-container > .g-grid {
        align-items: center;
    }

    #g-container-main:has(.news-to-me) .g-title {
        margin: 0;
        padding: 0;
        color: var(--default-white);
        text-align: center;
        font-size: min(3vw, 3rem);
        line-height: 1;
        font-family: var(--title-font-family);
        font-weight: 700;
        position: relative;
        padding-bottom: min(1vw, 1rem);
    }
    #g-container-main:has(.news-to-me) .g-title:after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 10%;
        right: 10%;
        border-bottom: 2px solid var(--default-white);
    }

    .site-home #g-mainbar {
        display: flex;
        flex-direction: column;
        gap: min(2vw, 2rem);
    }

    .news-button > .g-content {
        text-align: center;
    }
    .news-button .button {
        background: var(--default-white)!important;
        color: var(--primary-color)!important;
        font-family: var(--title-font-family)!important;
        font-size: min(1.5vw, 1.5rem)!important;
        text-align: center!important;
        padding: min(1.75vw, 1.75rem) min(6vw, 6rem)!important;
        position: relative!important;
        text-transform: none!important;
        font-variant-caps: normal!important;
    }
    .news-button .button:before {
        content: '';
        position: absolute;
        border: 2px solid var(--primary-color);
        top: min(.75vw, .75rem);
        bottom: min(.75vw, .75rem);
        left: min(.75vw, .75rem);
        right: min(.75vw, .75rem);
        border-radius: .25rem;
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home.withmaxwidth #g-container-main > .g-container {
        padding: 2rem 1rem!important;
    }
    #g-container-main:has(.news-to-me) > .g-container > .g-grid {
        align-items: center;
    }

    #g-container-main:has(.news-to-me) .g-title {
        margin: 0;
        padding: 0;
        color: var(--default-white);
        text-align: center;
        font-size: 6vw;
        line-height: 1;
        font-family: var(--title-font-family);
        font-weight: 700;
        position: relative;
        padding-bottom: 1rem;
    }
    #g-container-main:has(.news-to-me) .g-title:after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 10%;
        right: 10%;
        border-bottom: 2px solid var(--default-white);
    }

    .site-home #g-mainbar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .news-button > .g-content {
        text-align: center;
    }
    .news-button .button {
        background: var(--default-white)!important;
        color: var(--primary-color)!important;
        font-family: var(--title-font-family)!important;
        font-size: 4vw!important;
        text-align: center!important;
        padding: 1rem!important;
        position: relative!important;
        text-transform: none!important;
        font-variant-caps: normal!important;
    }
    .news-button .button:before {
        content: '';
        position: absolute;
        border: 2px solid var(--primary-color);
        top: .3rem;
        bottom: .3rem;
        left: .3rem;
        right: .3rem;
        border-radius: .5rem;
    }
}

@media only screen and (min-width: 50.99rem) {
    .ph-imgcard {
        margin: 0;
        padding: 0;
    }
    .ph-imgcard > .g-content {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: min(2vw, 2rem);
        align-items: center;
    }
    .ph-imgcard .g-content-array {
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: min(2vw, 2rem);
        width: 100%;
    }
    .ph-imgcard .g-content-array > .g-grid {
        margin: 0;
        padding: 0;
        position: relative;
        border: 1px solid var(--default-white);
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        border-radius: .5rem;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-content-array > .g-grid:hover {
        transform: scale(1.05);
    }
    .ph-imgcard .g-content-array > .g-grid > .g-block {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-content-array > .g-grid > .g-block > .g-content {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item-image {
        margin: 0;
        padding: 0;
        border-bottom: .5rem solid var(--default-white);
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item-image a {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item-image img {
        margin: 0;
        padding: 0;
        width: 100%;
        height: auto;
        aspect-ratio: 16/9;
        object-position: center;
        object-fit: cover;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item-read-more {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
    .ph-imgcard .g-array-item-read-more a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
}

@media only screen and (max-width: 50.99rem) {
    .ph-imgcard {
        margin: 0;
        padding: 0;
    }
    .ph-imgcard > .g-content {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
    }
    /*.ph-imgcard .g-content-array {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
    }
    .ph-imgcard .g-content-array > .g-grid {
        margin: 0;
        padding: 0;
        position: relative;
        border: 1px solid var(--default-white);
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        border-radius: .5rem;
        transition: .3s all ease-in-out;
    }*/
    .ph-imgcard .g-content-array {
        margin: 0;
        padding: 0 max(1rem, calc((100% - 75vw) / 2));
        display: flex;
        flex-direction: row;
        gap: 1rem;
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-padding-left: max(1rem, calc((100% - 75vw) / 2));
        scroll-padding-right: max(1rem, calc((100% - 75vw) / 2));
        -webkit-overflow-scrolling: touch;
        box-sizing: border-box;
    }

    .ph-imgcard .g-content-array > .g-grid {
        margin: 0;
        padding: 0;
        position: relative;
        border: 1px solid var(--default-white);
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        border-radius: .5rem;
        transition: .3s all ease-in-out;
        flex: 0 0 75vw;
        scroll-snap-align: center;
        scroll-snap-stop: always;
    }
    .ph-imgcard .g-content-array > .g-grid:hover {
        transform: scale(1.05);
    }
    .ph-imgcard .g-content-array > .g-grid > .g-block {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-content-array > .g-grid > .g-block > .g-content {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item-image {
        margin: 0;
        padding: 0;
        border-bottom: .5rem solid var(--default-white);
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item-image a {
        margin: 0;
        padding: 0;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item-image img {
        margin: 0;
        padding: 0;
        width: 100%;
        height: auto;
        aspect-ratio: 16/9;
        object-position: center;
        object-fit: cover;
        transition: .3s all ease-in-out;
    }
    .ph-imgcard .g-array-item-read-more {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
    .ph-imgcard .g-array-item-read-more a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
    }
}

/*EXPANDED*/
@media only screen and (min-width: 50.99rem) {
    .site-home #g-expanded > .g-container {
        padding: min(4vw, 4rem) min(2vw, 2rem) min(2vw, 2rem) min(2vw, 2rem)!important;
    }
    .site-home #g-expanded > .g-container > .g-grid {
        display: flex;
        flex-direction: row;
        gap: min(3vw, 3rem);
    }
    .site-home #g-expanded > .g-container > .g-grid .column-container {
        background: var(--default-white);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        width: unset;
        max-width: unset;
        flex: 1;
        padding: min(2.5vw, 2.5rem);
    }
}

@media only screen and (max-width: 50.99rem) {
    .site-home.withmaxwidth #g-expanded > .g-container {
        padding: 2rem 1rem!important;
    }
    .site-home #g-expanded > .g-container > .g-grid {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .site-home #g-expanded > .g-container > .g-grid .column-container {
        background: var(--default-white);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--default-box-shadow);
        width: unset;
        max-width: unset;
        flex: 1;
        padding: 1rem;
    }
}

@media only screen and (min-width: 50.99rem) {
    .column-container > .g-content {
        height: 100%;
    }
    .column-container > .g-content > .g-content-array {
        height: 100%;
    }
    .column-container > .g-content > .g-content-array > .g-grid {
        height: 100%;
    }
    .column-container > .g-content > .g-content-array > .g-grid > .g-block {
        height: 100%;
    }
    .column-container > .g-content > .g-content-array > .g-grid > .g-block > .g-content {
        height: 100%;
    }
    .column-container > .g-content > .g-content-array > .g-grid > .g-block > .g-content > .g-array-item {
        height: 100%;
    }
    .column-container > .g-content > .g-content-array > .g-grid > .g-block > .g-content > .g-array-item > .g-array-item-text {
        height: 100%;
    }
}

@media only screen and (min-width: 50.99rem) {
    .column-wrapper {
        display: flex;
        flex-direction: column;
        gap: min(1.5vw, 1.5rem);
        height: 100%;
    }
    .column-wrapper .column-title .g-title {
        margin: 0;
        padding: 0;
        font-size: min(3vw, 3rem);
        font-weight: 500;
        line-height: 1;
        color: var(--primary-color);
        font-family: var(--title-font-family);
        border: none;
    }
    .column-wrapper .column-content {
        flex: 1;
    }
    .column-wrapper .column-button .button {
        background: var(--primary-color)!important;
        color: var(--default-white)!important;
        font-family: var(--title-font-family)!important;
        font-size: min(1.5vw, 1.5rem)!important;
        text-align: center!important;
        padding: min(1.75vw, 1.75rem) min(6vw, 6rem)!important;
        position: relative!important;
        text-transform: none!important;
        font-variant-caps: normal!important;
        width: 100%;
    }
    .column-wrapper .column-button .button:before {
        content: '';
        position: absolute;
        border: 2px solid var(--default-white);
        top: min(.75vw, .75rem);
        bottom: min(.75vw, .75rem);
        left: min(.75vw, .75rem);
        right: min(.75vw, .75rem);
        border-radius: .25rem;
    }

    .funeral-content .g-array-item-read-more {
        display: none!important;
    }

    .funeral-content .g-array-item-title {
        margin: 0;
        padding: 0;
        border: none;
    }
    .funeral-content .g-item-title {
        margin: 0;
        padding: 0;
        border: none;
        line-height: 1.5;
        font-weight: 700;
        font-family: var(--body-font-family);
        font-size: min(1.75vw, 1.75rem);
    }
    .funeral-content .g-item-title a {
        margin: 0;
        padding: 0;
        border: none;
    }
}

@media only screen and (max-width: 50.99rem) {
    .column-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }
    .column-wrapper .column-title .g-title {
        margin: 0;
        padding: 0;
        font-size: 8vw;
        font-weight: 500;
        line-height: 1;
        color: var(--primary-color);
        font-family: var(--title-font-family);
        border: none;
    }
    .column-wrapper .column-content {
        flex: 1;
    }
    .column-wrapper .column-button .button {
