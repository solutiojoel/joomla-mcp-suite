/*FOOTER*/
@media only screen and (min-width: 50.99rem) {
    #g-container-footer {
        background: url('/images/template/bg-footer.jpg') 50% 50% no-repeat;
        background-size: cover;
        border-bottom: 1.5rem solid var(--tertiary-color);
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-container-footer {
        background: url('/images/template/bg-footer.jpg') 50% 50% no-repeat;
        background-size: cover;
        border-bottom: 1.5rem solid var(--tertiary-color);
    }
}

@media only screen and (min-width: 50.99rem) {
    #g-footer > .g-container {
        padding: min(2vw, 2rem) min(2vw, 2rem) min(5vw, 5rem) min(2vw, 2rem)!important;
    }

    .footer-wrapper {
        display: flex;
        flex-direction: row;
        gap: min(4vw, 4rem);
        align-items: center;
    }
    .footer-wrapper .footer-logo {
        flex: 6;
    }
    .footer-wrapper .footer-logo img {
        width: 100%;
    }
    .footer-wrapper .footer-content-boxes {
        flex: 4;
        display: flex;
        flex-direction: row;
        gap: min(2vw, 2rem);
        align-items: center;
        justify-content: flex-end;
    }
    .footer-wrapper .footer-content-boxes:before {
        content: '';
        height: min(12vw, 12rem);
        border-left: 2px solid var(--default-white);
        max-width: 2px;
        order: 2;
    }
    .footer-wrapper .footer-content {
        order: 1;
    }
    .footer-wrapper .footer-content p {
        margin: 0;
        padding: 0;
        font-size: min(1.25vw, 1.25rem);
        line-height: 2;
        color: var(--default-white);
    }
    .footer-wrapper .footer-links {
        order: 3;
    }
    .footer-wrapper .footer-links .footer-inner-links {
        display: flex;
        flex-direction: column;
    }
    .footer-wrapper .footer-links .footer-inner-links a {
        font-size: min(1.25vw, 1.25rem);
        line-height: 2;
        color: var(--default-white);
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-footer > .g-container {
        padding: 2rem 1rem 5rem 1rem!important;
    }

    .footer-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: flex-start;
    }
    .footer-wrapper .footer-logo {
        flex: 6;
    }
    .footer-wrapper .footer-logo img {
        width: 100%;
    }
    .footer-wrapper .footer-content-boxes {
        flex: 4;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
        justify-content: flex-start;
    }
    /*.footer-wrapper .footer-content-boxes:before {
        content: '';
        height: min(12vw, 12rem);
        border-left: 2px solid var(--default-white);
        max-width: 2px;
        order: 2;
    }*/
    .footer-wrapper .footer-content {
        order: 1;
    }
    .footer-wrapper .footer-content p {
        margin: 0;
        padding: 0;
        font-size: 4vw;
        line-height: 2;
        color: var(--default-white);
    }
    .footer-wrapper .footer-links {
        order: 3;
    }
    .footer-wrapper .footer-links .footer-inner-links {
        display: flex;
        flex-direction: column;
    }
    .footer-wrapper .footer-links .footer-inner-links a {
        font-size: 4vw;
        line-height: 2;
        color: var(--default-white);
    }
}

/*BOTTOM*/
@media only screen and (min-width: 50.99rem) {
    #g-bottom {
        position: relative;
        z-index: 10;
    }
    #g-bottom > .g-container {
        padding: 2rem 0!important;
    }
    #g-bottom .admod td {
        padding-top: 0!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    #g-bottom {
        position: relative;
        z-index: 10;
    }
    body.site.withmaxwidth #g-bottom > .g-container {
        padding-left: 0!important;
        padding-right: 0!important;
        padding: 2rem 0!important;
    }
    #g-bottom .admod td {
        padding-top: .5rem!important;
    }
}

.search-page #searchForm .btn {
    background: var(--primary-color);
}

.grid-articles .g-array-item-text a:not(a.button) {
    color: var(--primary-color);
}
.grid-articles .g-array-item-text a {
    color: var(--primary-color);
}

@media only screen and (max-width: 50.99rem) {
    .admod.adside tbody {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: .5rem .5rem;
    }
}

@media only screen and (max-width: 50.99rem) {
    body#site-grid.newslayout #g-container-main > .g-container {
        padding: 2rem 1rem!important;
    }
    body#site-grid.newslayout #g-container-main #g-mainbar {
        margin: 0!important;
        padding: 0!important;
    }

    #site-grid.newslayout .grid-mobile-stacked .g-item-title {
        --grid-title-font-size: 3vw;
    }
}

@media only screen and (max-width: 50.99rem) {
    body .side-menu-particle .g-blockcontent-subcontent-title-text {
        --side-menu-font-size-desktop: 4vw;
    }
}

/* QUICK LINKS WINDOWSILL STYLING */
.ql-windowsill {
    --ql-border-radius: 1rem;
}

@media only screen and (min-width: 50.99rem) {
    .ql-windowsill .g-grid {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: row;
        gap: min(1.5vw, 1.5rem);
        flex-wrap: wrap;
    }

    .ql-windowsill .g-blockcontent-subcontent-block {
        margin: 0;
        padding: 0;
        flex: 1;
    }

    .ql-windowsill .g-blockcontent-subcontent-block-content {
        margin: 0;
        padding: 0;
        position: relative;
        padding: min(1vw, 1rem);
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: var(--ql-border-radius);
        box-shadow: var(--default-box-shadow);
        transition: .2s all ease-in-out;
    }

    .ql-windowsill .g-blockcontent-subcontent-block-content:before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        background: var(--default-white);
        border-radius: var(--ql-border-radius);
        z-index: 1;
    }

    .ql-windowsill .g-blockcontent-subcontent-block-content:after {
        content: "";
        position: absolute;
        top: min(1vw, 1rem);
        bottom: min(1vw, 1rem);
        left: min(1vw, 1rem);
        right: min(1vw, 1rem);
        height: auto;
        width: calc(100% - min(2vw, 2rem));
        aspect-ratio: 4 / 3;
        border-radius: var(--ql-border-radius);
        box-shadow: inset var(--default-box-shadow);
        z-index: 3;
    }

    .ql-windowsill .g-blockcontent-subcontent-img {
        margin: 0;
        padding: 0;
        border-radius: var(--ql-border-radius);
        aspect-ratio: 4/3;
        width: 100%;
        height: auto;
        object-position: center;
        object-fit: cover;
        position: relative;
        z-index: 2;
        box-shadow: inset var(--default-box-shadow);
        transition: .2s all ease-in-out;
    }

    .ql-windowsill .g-blockcontent-subcontent-block-content:hover {
        transform: scale(1.10);
        box-shadow: var(--default-box-shadow);
    }

    .ql-windowsill .g-blockcontent-subcontent-title {
        margin: 0;
        padding: 0;
        position: absolute;
        bottom: min(-1vw, -1rem);
        left: min(.75vw, .75rem);
        right: min(.75vw, .75rem);
        width: calc(100% - min(1.5vw, 1.5rem));
        height: min(3.5vw, 3.5rem);
        max-height: min(3vw, 3rem);
        background: var(--secondary-color);
        z-index: 4;
        border-radius: .45rem;
        box-shadow: var(--default-box-shadow);
        padding: min(.5vw, .5rem);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: min(1.25vw, 1.25rem);
        line-height: 1.2;
    }

    .ql-windowsill .g-blockcontent-subcontent-title-text {
        margin: 0;
        padding: 0;
        font-size: min(1.25vw, 1.25rem);
        line-height: 1.2;
        text-align: center;
        color: var(--default-white);
        font-family: var(--title-font-family);
        text-transform: none;
        font-variant-caps: normal;
        letter-spacing: 2px;
        font-weight: 700;
    }

    .ql-windowsill .g-blockcontent-buttons {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
        z-index: 5;
    }

    .ql-windowsill .g-blockcontent-buttons a {
        margin: 0;
        padding: 0;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
        z-index: 5;
    }
}

@media only screen and (max-width: 50.99rem) {
    .ql-windowsill .g-blockcontent-subcontent {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 2rem 1rem;
        justify-content: center;
    }

    .ql-windowsill .g-blockcontent-subcontent-block {
        min-width: calc(50% - .5rem);
        max-width: calc(50% - .5rem);
    }
    .ql-windowsill .g-blockcontent-subcontent-block-content {
        position: relative;
        padding: 1rem;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: var(--ql-border-radius);
        box-shadow: var(--default-box-shadow);
        transition: .2s all ease-in-out;
    }

    .ql-windowsill .g-blockcontent-subcontent-block-content:before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        background: var(--default-white);
        border-radius: var(--ql-border-radius);
        z-index: 1;
    }

    .ql-windowsill .g-blockcontent-subcontent-block-content:after {
        content: "";
        position: absolute;
        top: 1rem;
        bottom: 1rem;
        left: 1rem;
        right: 1rem;
        height: auto;
        width: calc(100% - 2rem);
        aspect-ratio: 4 / 3;
        border-radius: var(--ql-border-radius);
        box-shadow: inset var(--default-box-shadow);
        z-index: 3;
    }

    .ql-windowsill .g-blockcontent-subcontent-img {
        border-radius: var(--ql-border-radius);
        aspect-ratio: 4 / 3;
        width: 100%;
        height: auto;
        object-position: center;
        object-fit: cover;
        position: relative;
        z-index: 2;
        box-shadow: inset var(--default-box-shadow);
    }

    .ql-windowsill .g-blockcontent-subcontent-title {
        position: absolute;
        bottom: -0.75rem;
        left: 0.5rem;
        right: 0.5rem;
        width: calc(100% - 1rem);
        background: var(--secondary-color);
        z-index: 4;
        border-radius: 0.5rem;
        box-shadow: var(--default-box-shadow);
        padding: 0.5rem;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 0.9rem;
    }

    .ql-windowsill .g-blockcontent-subcontent-title-text {
        font-size: 0.9rem;
        text-align: center;
        color: var(--default-white);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
    }

    .ql-windowsill .g-blockcontent-buttons {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
        z-index: 5;
    }

    .ql-windowsill .g-blockcontent-buttons a {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100%;
        width: 100%;
        opacity: 0;
        z-index: 5;
    }
}

@media only screen and (max-width: 50.99rem) {
    @media (display-mode: standalone) {
        #g-container-footer {
            border: none!important;
        }
    }
}

@media only screen and (max-width: 50.99rem) {
    .grid-img-box-shadow-50 .g-array-item-image {
        box-shadow: none!important;
    }
    .grid-mobile-stacked .g-array-item-image img {
        box-shadow: none!important;
    }
}

@media only screen and (max-width: 50.99rem) {
    .bulletin-page .koowa_media {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .bulletin-page .koowa_media__item {
        flex: 1;
        min-width: calc(50% - .5rem);
        max-width: calc(50% - .5rem);
    }
}