{
  // gantry-mcp is plain CommonJS JavaScript and stays that way — there is no
  // build step and nothing is emitted. TypeScript is used only as a checker
  // over JSDoc, so the class of bug that shipped here before (using findNode's
  // `{ node, parent, index }` result as if it were the node itself) is caught
  // at `npm run typecheck` instead of at runtime, mid-session, in an agent's
  // layout edit.
  //
  // Deliberately not strict. Turning on noImplicitAny across ~5,000 lines of
  // untyped JS would report hundreds of findings that say nothing about
  // correctness, and a check nobody can keep green is a check nobody runs.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    // node20, not the deprecated node10 — TypeScript 7 drops the latter. node20
    // is also what models `require()` of an ESM package correctly: this app is
    // CommonJS and requires @solutio/env and @solutio/mcp-transport, which are
    // ESM. Node supports that from 22.12, and node16 does not know it.
    "module": "node20",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    // page.evaluate() callbacks run in the browser, so both libs are needed.
    // dom.iterable is what makes `[...el.querySelectorAll(...)]` legal.
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": ["mcp-server.js", "lib/**/*.js", "test/**/*.js", "types/**/*.d.ts"],
  "exclude": ["node_modules", "workspace"]
}
