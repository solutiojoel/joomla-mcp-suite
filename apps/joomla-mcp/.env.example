# Joomla shared credentials (used for all sites; only the URL changes per session)
JOOMLA_BASE_URL=https://your-default-site.example.com/administrator

# Freshdesk credentials (optional — omit to disable Freshdesk tools)
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=your-api-key-here
JOOMLA_USERNAME=shannon
JOOMLA_PASSWORD=your-password-here

# FTP credentials (shared across all sites; site-to-host mapping lives in ftp-sites.json)
FTP_READONLY_USER=shanro
FTP_READONLY_PASS=your-readonly-ftp-password
FTP_WRITE_USER=shannon
FTP_WRITE_PASS=your-write-ftp-password

# FTP credentials for forge.solutiosoftware.net (credential_set: "forge" in ftp-sites.json)
# Falls back to FTP_FORGE_USER/PASS if _READONLY/_WRITE variants are not set
FTP_FORGE_READONLY_USER=your-forge-readonly-user
FTP_FORGE_READONLY_PASS=your-forge-readonly-password
FTP_FORGE_WRITE_USER=your-forge-write-user
FTP_FORGE_WRITE_PASS=your-forge-write-password

# Retired module types. Comma-separated, case-insensitive, matched as a SUBSTRING of
# the type's title — so "roksprocket" covers every RokSprocket variant an install
# exposes. Keep entries specific: a short entry can match a title you meant to keep.
#
# This blocks CREATING modules of that type. It does not block reading, editing,
# toggling or deleting modules that already exist — legacy modules stay fully editable.
# MODULE_TYPE_BLACKLIST=roksprocket

# HTTP port (set to 9300 for Docker; overridden by docker-compose.yml)
HTTP_PORT=9300

# Retired menu item types. Comma-separated, case-insensitive, matched on the full
# label (exact match, unlike MODULE_TYPE_BLACKLIST above).
# MENU_ITEM_TYPE_BLACKLIST=

# Optional: comma-separated tool names to disable
# DISABLED_TOOLS=
