{
  "servers": {
    "joomla-mcp": {
      "type": "stdio",
      "command": "node",
      "cwd": "${workspaceFolder}",
      "args": [
        "dist/index.js"
      ],
      "envFile": "${workspaceFolder}/.env",
      "dev": {
        "watch": "src/**/*.ts",
        "debug": {
          "type": "node"
        }
      }
    },
  }
}
