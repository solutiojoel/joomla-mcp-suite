# Bearer token for MCP Inspector / Claude clients connecting to THIS server
MCP_TOKEN_INSPECTOR=anypasswordyouwant

# Downstream server URLs (defaults point to host machine via host.docker.internal)
JOOMLA_MCP_URL=http://host.docker.internal:9300/mcp
GANTRY_MCP_URL=http://host.docker.internal:9301/mcp

# Bearer tokens for the downstream servers (must match their MCP_TOKEN_* values)
JOOMLA_MCP_TOKEN=yourjoomlatoken
GANTRY_MCP_TOKEN=yourgantrytoken

# HTTP port
HTTP_PORT=9302
