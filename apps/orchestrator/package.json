{
  "name": "orchestrator",
  "version": "1.0.0",
  "description": "MCP orchestrator that routes content requests to joomla-mcp and design requests to gantry-mcp",
  "main": "orchestrator.js",
  "scripts": {
    "start": "node orchestrator.js",
    "start:http": "cross-env HTTP_PORT=9302 node orchestrator.js",
    "test": "node test-scope-enforcement.cjs && node test-kb-scoping.cjs && node test-menu-spec.cjs",
    "test:integration": "node test-downstream-routing.cjs"
  },
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solutio/logging": "^0.1.0",
    "@solutio/mcp-downstream-client": "^0.1.0",
    "@solutio/mcp-transport": "^0.1.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
