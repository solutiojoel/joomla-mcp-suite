# ── Chrome ──────────────────────────────────────────────────────────────────
# Port Chrome is listening on when launched with --remote-debugging-port
CHROME_PORT=9222

# Full path to Chrome executable (auto-detected on Windows/macOS/Linux if omitted)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── Bridge server (browser extension → MCP) ─────────────────────────────────
BRIDGE_PORT=9224

# ── FTP ─────────────────────────────────────────────────────────────────────
FTP_HOST=your-server.com
FTP_USER=username
FTP_PASSWORD=password
# Set to true for FTPS (FTP over TLS)
FTP_SECURE=false

# Default remote path used when css_upload_ftp doesn't specify one
FTP_DEFAULT_CSS_PATH=/templates/g5_hydrogen/custom/css/custom.css
