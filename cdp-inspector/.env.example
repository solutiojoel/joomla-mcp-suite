# ── Transport ────────────────────────────────────────────────────────────────
# stdio  = local Claude Code usage (default)
# http   = network-accessible; use this for Docker / Tailscale
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=http)
MCP_PORT=3100
MCP_HOST=0.0.0.0

# Allowed CORS origin for browser-based MCP clients.
# Use '*' to allow any origin, or lock it down (e.g. http://localhost:8090)
CORS_ORIGIN=*

# ── Bridge server (browser extension → MCP) ─────────────────────────────────
# In stdio mode the bridge runs on its own port.
# In http mode the bridge shares MCP_PORT — these are ignored.
BRIDGE_PORT=9224
BRIDGE_HOST=0.0.0.0

# ── Chrome ──────────────────────────────────────────────────────────────────
CHROME_PORT=9222
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── FTP ─────────────────────────────────────────────────────────────────────
FTP_HOST=your-server.com
FTP_USER=username
FTP_PASSWORD=password
FTP_SECURE=false
FTP_DEFAULT_CSS_PATH=/templates/g5_hydrogen/custom/css/custom.css
