{
  "name": "menu-build",
  "description": "Menu building — PDF → Menu Spec → Joomla skeleton (Phases 1–4 only)",
  "instructions": "menu-build-agent.md",
  "tools": {
    "allow": [
      "set_active_site", "get_active_site", "get_agent_instructions",
      "get_site_notes", "append_site_note", "write_site_notes",
      "read_agent_doc", "reload_tools",
      "joomla_article", "joomla_category", "joomla_menu*",
      "joomla_media", "joomla_bulk_checkin",
      "joomla_get_frontend_*", "joomla_verify_frontend_content",
      "joomla_redirects_list", "joomla_site_config_inspect",
      "joomla_backend_inventory",
      "joomla_docman_*", "joomla_fileman_list_files",
      "joomla_workspace_write"
    ],
    "deny": [
      "joomla_submit_admin_form", "joomla_permissions",
      "joomla_user*", "joomla_group*",
      "joomla_component_inspect",
      "joomla_inspect_admin_form", "joomla_inspect_admin_list"
    ],
    "_rules_comment": "Argument-level rules for this agent. Same format as toolRules in tool-policy.json.",
    "rules": {}
  },
  "docs": {
    "allow": ["global/*", "menu-build/*"]
  }
}
