{
  "name": "@solutio/mcp-transport",
  "version": "0.1.0",
  "description": "Shared StreamableHTTP + stdio bootstrap for the suite's MCP servers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
